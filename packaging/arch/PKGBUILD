# Maintainer: Martin Velichkovski <martinrobotika@gmail.com>
pkgname=xodus-launcher-git
pkgver=r0
pkgrel=1
pkgdesc="PC Game Pass launcher for Linux built on xodus and WineGDK"
arch=('any')
url="https://github.com/evilcomputer12/xodus-launcher"
license=('GPL-3.0-or-later')
depends=('python' 'pyside6' 'xodus-git' 'libsecret' 'desktop-file-utils' 'hicolor-icon-theme')
optdepends=('steam: add games as Steam shortcuts'
            'konsole: terminal for the sign-in helper entries'
            'mingw-w64-gcc: build WineGDK with scripts/build-winegdk.sh')
makedepends=('git')
provides=('xodus-launcher')
conflicts=('xodus-launcher')
source=("git+https://github.com/evilcomputer12/xodus-launcher.git")
sha256sums=('SKIP')

pkgver() {
	cd "$srcdir/xodus-launcher"
	printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

package() {
	cd "$srcdir/xodus-launcher"
	install -Dm755 launcher/xodus_launcher.py "$pkgdir/usr/share/xodus-launcher/xodus_launcher.py"
	install -Dm755 /dev/stdin "$pkgdir/usr/bin/xodus-launcher" <<'SH'
#!/bin/sh
exec python3 /usr/share/xodus-launcher/xodus_launcher.py "$@"
SH
	install -Dm644 data/xodus-launcher.desktop "$pkgdir/usr/share/applications/xodus-launcher.desktop"
	sed -i 's|^Exec=.*|Exec=xodus-launcher|' "$pkgdir/usr/share/applications/xodus-launcher.desktop"
	install -Dm644 data/xodus.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/xodus.png"
	install -Dm755 scripts/build-winegdk.sh "$pkgdir/usr/share/xodus-launcher/scripts/build-winegdk.sh"
	install -Dm644 patches/winegdk/* -t "$pkgdir/usr/share/xodus-launcher/patches/winegdk/"
	install -Dm644 README.md LICENSE -t "$pkgdir/usr/share/doc/xodus-launcher/"
}
