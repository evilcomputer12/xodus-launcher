+++ b/dlls/xgameruntime/main.c
@@ -244,7 +244,7 @@ HRESULT WINAPI QueryApiImpl( const GUID *runtimeClassId, REFIID interfaceId, voi
     }
     else if ( IsEqualGUID( runtimeClassId, &CLSID_XGameSaveImpl ) )
     {
-        return IXGameSaveImpl3_QueryInterface( x_game_save, interfaceId, out );
+        return IXGameSaveImpl4_QueryInterface( x_game_save, interfaceId, out );
     }
     else if ( IsEqualGUID( runtimeClassId, &CLSID_XGameImpl ) )
     {
diff --git a/dlls/xgameruntime/private.h b/dlls/xgameruntime/private.h
index 56feb61..cb379b2 100644
--- a/dlls/xgameruntime/private.h
+++ b/dlls/xgameruntime/private.h
@@ -132,7 +132,7 @@ void xodus_install_force_close( HINSTANCE module );
 extern IXGameRuntimeFeatureImpl *x_game_runtime_feature;
 extern IXSystemImpl *x_system;
 extern IXGameImpl3 *x_game;
-extern IXGameSaveImpl3 *x_game_save;
+extern IXGameSaveImpl4 *x_game_save;
 extern IXPersistentLocalStorageImpl3 *x_persistent_local_storage;
 extern IXSystemAnalyticsImpl *x_system_analytics;
 extern IXNetworkingImpl *x_networking;
diff --git a/include/xgamesave.idl b/include/xgamesave.idl
index 07cdcfc..92bb528 100644
--- a/include/xgamesave.idl
+++ b/include/xgamesave.idl
@@ -116,12 +116,55 @@ interface IXGameSaveImpl3 : IXGameSaveImpl2
 {
 }
 
+typedef struct PFXGameSaveConfig *PFXGameSaveConfigHandle;
+typedef struct PFXGameSaveUiCallbacks PFXGameSaveUiCallbacks;
+
+/* PFXGameSave.h: request for PFXGameSaveInitializeConfig */
+struct PFXGameSaveConfigRequest
+{
+    XUserHandle requestingUser;
+    const char *titleId;
+    const char *apiUrl;
+    UINT32 flags;
+    const char *entityId;
+    const char *entityToken;
+    const char *fileLocation;
+};
+
+/* GDK 2504+: the PlayFab game save API (PFXGameSave.h) is served by the same class. Slot order
+ * taken from the XGameSave wrappers of xgameruntime.lib (GDK 2510). */
+[
+    local,
+    object,
+    uuid(ab4ae4fb-6508-4950-a032-45fd4bf8c43b)
+]
+interface IXGameSaveImpl4 : IXGameSaveImpl3
+{
+    HRESULT PFXGameSaveInitializeConfig( [in] struct PFXGameSaveConfigRequest *configRequest, [out] PFXGameSaveConfigHandle *config );
+    void PFXGameSaveFreeConfig( [in] PFXGameSaveConfigHandle config );
+    HRESULT PFXGameSaveFilesGetFolderWithUiAsync( [in] PFXGameSaveConfigHandle configHandle, [in] XAsyncBlock *async );
+    HRESULT PFXGameSaveFilesGetFolderWithUiResult( [in] XAsyncBlock *async, [in] SIZE_T folderSize, [out] char *folderResult );
+    HRESULT PFXGameSaveFilesGetRemainingQuota( [in] PFXGameSaveConfigHandle configHandle, [out] INT64 *remainingQuota );
+    HRESULT PFXGameSaveSetUiCallbacks( [in] PFXGameSaveUiCallbacks *callbacks );
+    HRESULT PFXGameSaveProgressUiGetProgress( [in] XUserHandle requestingUser, [out] UINT32 *syncState, [out] UINT64 *current, [out] UINT64 *total );
+    HRESULT PFXGameSaveSetProgressUiResponse( [in] XUserHandle requestingUser, [in] UINT32 response );
+    HRESULT PFXGameSaveSetSyncFailedUiResponse( [in] XUserHandle requestingUser, [in] UINT32 response );
+    HRESULT PFXGameSaveSetActiveDeviceContentionUiResponse( [in] XUserHandle requestingUser, [in] UINT32 response );
+    HRESULT PFXGameSaveSetConflictUiResponse( [in] XUserHandle requestingUser, [in] UINT32 response );
+    HRESULT PFXGameSaveSetOutOfStorageUiResponse( [in] XUserHandle requestingUser, [in] UINT32 response );
+    HRESULT PFXGameSaveFilesUploadWithUiAsync( [in] PFXGameSaveConfigHandle configHandle, [in] UINT32 options, [in] XAsyncBlock *async );
+    HRESULT PFXGameSaveFilesUploadWithUiResult( [in] XAsyncBlock *async );
+    HRESULT PFXGameSaveFilesSetSaveDescriptionAsync( [in] PFXGameSaveConfigHandle configHandle, [in] const char *shortSaveDescription, [in] XAsyncBlock *async );
+    HRESULT PFXGameSaveFilesSetSaveDescriptionResult( [in] XAsyncBlock *async );
+    HRESULT PFXGameSaveSetActiveDeviceChangedCallback( [in] void *callback, [in] void *context );
+}
+
 [
     uuid(704c3f58-e629-4cc2-b197-30511b996fe2)
 ]
 coclass XGameSaveImpl
 {
-    [default] interface IXGameSaveImpl3;
+    [default] interface IXGameSaveImpl4;
 }
 
 cpp_quote("#endif")
