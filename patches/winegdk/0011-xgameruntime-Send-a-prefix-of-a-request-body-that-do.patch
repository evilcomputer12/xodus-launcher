From 9f2dd8ead3015b23fb314ca040bd8496c8025ae0 Mon Sep 17 00:00:00 2001
From: evilcomputer12 <martinrobotika@gmail.com>
Date: Sat, 10 Oct 2026 02:33:42 +0200
Subject: [PATCH 11/20] xgameruntime: Send a prefix of a request body that does
 not fit the token frame.

The whole body of an XUserGetTokenAndSignatureAsync request was base64
encoded into the TokenAndSignatureRequest and SendXmlRequest rejects a
frame body above the u16 length, so a request with a body over roughly
48 KB (XSAPI title storage uploads pass 256 KB blocks) always failed
with E_GAMEUSER_FAILED_TO_GET_TOKEN. The Xbox Live signature covers
only the first MaxBodyBytes of the body, 8192 for the policy every
ordinary endpoint uses, so when the whole body does not fit the frame
send just that prefix: the signature comes out the same. Bodies that
fit still go out whole, which keeps the few endpoints whose policy
covers the whole body (settings, privileges, device.mgt,
experimentation) signed correctly for every request size they see.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../GDKComponent/Xodus/XodusService.cpp       | 24 +++++++++++++++----
 dlls/xgameruntime/private.h                   |  9 +++++++
 dlls/xgameruntime/xodusprovider.idl           |  1 +
 3 files changed, 30 insertions(+), 4 deletions(-)

diff --git a/dlls/xgameruntime/GDKComponent/Xodus/XodusService.cpp b/dlls/xgameruntime/GDKComponent/Xodus/XodusService.cpp
index 5640572..f298fc5 100644
--- a/dlls/xgameruntime/GDKComponent/Xodus/XodusService.cpp
+++ b/dlls/xgameruntime/GDKComponent/Xodus/XodusService.cpp
@@ -243,7 +243,7 @@ private:
         TRACE( "requestType %u, %Iu bytes, timeoutMs %u, expectedType %u\n", (unsigned)requestType, xmlLen, timeoutMs, (unsigned)expectedType );
 
         *responseXml = nullptr;
-        if ( !xmlLen || xmlLen > 0xFFFF ) return E_INVALIDARG; /* u16 length on the wire */
+        if ( !xmlLen || xmlLen > IPC_MAX_BODY_BYTES ) return E_INVALIDARG; /* u16 length on the wire */
 
         status = WindowsCreateString( RuntimeClass_Windows_Storage_Streams_Buffer, lstrlenW( RuntimeClass_Windows_Storage_Streams_Buffer ), &bufferClass );
         if ( FAILED( status ) ) goto _CLEANUP;
@@ -347,6 +347,7 @@ _CLEANUP:
         std::vector<LPCSTR> names, values;
         LPSTR xmlStr = nullptr, responseXml = nullptr;
         HRESULT status;
+        UINT32 bodySize = static_cast<UINT32>(params->body.size());
         ITokenAndSignatureResponse *tokenResponse = nullptr;
 
         TRACE( "invoker %p, param %p, result %p\n", invoker, param, result );
@@ -356,11 +357,26 @@ _CLEANUP:
         for ( auto &n : params->headerNames ) names.push_back( n.c_str() );
         for ( auto &v : params->headerValues ) values.push_back( v.c_str() );
 
-        status = xodus_xml_builder->BuildTokenAndSignatureRequestXml( params->clientId.c_str(), params->titleId, params->method.c_str(), params->url.c_str(),
-                                                                      static_cast<UINT32>(names.size()), names.data(), values.data(),
-                                                                      static_cast<UINT32>(params->body.size()), params->body.data(), params->forceRefresh, &xmlStr );
+        auto build = [&]( UINT32 size ) {
+            return xodus_xml_builder->BuildTokenAndSignatureRequestXml( params->clientId.c_str(), params->titleId, params->method.c_str(), params->url.c_str(),
+                                                                        static_cast<UINT32>(names.size()), names.data(), values.data(),
+                                                                        size, params->body.data(), params->forceRefresh, &xmlStr );
+        };
+
+        status = build( bodySize );
         if ( FAILED( status ) ) goto _CLEANUP;
 
+        if ( strlen( xmlStr ) > IPC_MAX_BODY_BYTES && bodySize > IPC_TOKEN_BODY_PREFIX_BYTES )
+        {
+            /* the frame cannot carry the whole body: send the prefix the signature covers (see private.h) */
+            TRACE( "a %u byte body does not fit the frame, sending its first %u bytes\n", bodySize, (unsigned)IPC_TOKEN_BODY_PREFIX_BYTES );
+            CoTaskMemFree( xmlStr );
+            xmlStr = nullptr;
+            bodySize = IPC_TOKEN_BODY_PREFIX_BYTES;
+            status = build( bodySize );
+            if ( FAILED( status ) ) goto _CLEANUP;
+        }
+
         status = SendXmlRequest( XodusMessageType::TokenAndSignatureRequest, xmlStr, params->timeoutMs, XodusMessageType::TokenAndSignatureResponse, &responseXml );
         if ( FAILED( status ) ) goto _CLEANUP;
 
diff --git a/dlls/xgameruntime/private.h b/dlls/xgameruntime/private.h
index 6d125e9..ca8522e 100644
--- a/dlls/xgameruntime/private.h
+++ b/dlls/xgameruntime/private.h
@@ -115,6 +115,15 @@
 #define IPC_TOKEN_TIMEOUT_MS 60000
 /* Largest frame body: the length field on the wire is a u16. */
 #define IPC_MAX_BODY_BYTES 0xFFFF
+/*
+ * XUserGetTokenAndSignature bodies cross the socket base64-encoded inside that frame. A body that
+ * does not fit is sent as this prefix: MaxBodyBytes of the Xbox Live signature policy every ordinary
+ * endpoint uses (title.mgt.xboxlive.com SignaturePolicies[0]), so the signature of such a request
+ * is the same as for the whole body. The few endpoints whose policy covers the whole body
+ * (settings, privileges, device.mgt, experimentation) only ever see small requests.
+ * Keep in sync with BODY_PREFIX_BYTES in crates/xodus/src/models/xgameruntime/xuser.rs.
+ */
+#define IPC_TOKEN_BODY_PREFIX_BYTES 8192
 /* 1 restores the old eager service handshake during XGameRuntimeInitialize (fatal when the service is down). */
 #define XODUS_INTEROP 0
 
diff --git a/dlls/xgameruntime/xodusprovider.idl b/dlls/xgameruntime/xodusprovider.idl
index 2291abd..41cbdce 100644
--- a/dlls/xgameruntime/xodusprovider.idl
+++ b/dlls/xgameruntime/xodusprovider.idl
@@ -120,6 +120,7 @@ namespace Xodus
         // Message type 5 -> 6. clientId may be NULL/empty and titleId 0 (user-only, unsigned token).
         // The operation succeeds whenever the service answered with a well-formed response, including one
         // carrying <Error>; callers read ITokenAndSignatureResponse::Error. Transport failures fail the operation.
+        // A body too large for the frame is sent as its first IPC_TOKEN_BODY_PREFIX_BYTES bytes (private.h).
         HRESULT TokenAndSignatureRequest( [in] LPCSTR clientId, [in] UINT32 titleId, [in] LPCSTR method, [in] LPCSTR url, [in] UINT32 headerCount, [in] LPCSTR *headerNames, [in] LPCSTR *headerValues, [in] UINT32 bodySize, [in] const BYTE *body, [in] boolean forceRefresh, [in] UINT32 timeoutMs, [out, retval] Windows.Foundation.IAsyncOperation<Xodus.ITokenAndSignatureResponse *> **operation );
         // Message type 7 -> 8. Same error convention as TokenAndSignatureRequest.
         HRESULT UserInfoRequest( [in] LPCSTR clientId, [in] UINT32 titleId, [in] boolean forceRefresh, [in] UINT32 timeoutMs, [out, retval] Windows.Foundation.IAsyncOperation<Xodus.IUserInfoResponse *> **operation );
