From 667c4cbac7cb2e53942eea37b8565928df72fb13 Mon Sep 17 00:00:00 2001
From: evilcomputer12 <martinrobotika@gmail.com>
Date: Sat, 10 Oct 2026 07:50:17 +0200
Subject: [PATCH 15/19] xgameruntime: Implement XStore contexts and the game
 license query.

XStoreCreateContext allocates a context for any user handle (NULL selects
the default user) and XStoreCloseContextHandle frees it. The game license
is answered asynchronously from a worker thread, the same pattern as the
SaveAsyncContext helper in XGameSave.cpp, with a full perpetual license
whose skuStoreId is the <StoreId> of MicrosoftGame.config (gdk_store_id,
parsed by InitInternalGDKC.cpp). XStoreRegisterGameLicenseChanged hands
out a token and the unregister returns TRUE; the license never changes,
so the callback is never invoked. XStoreQueryLicenseTokenAsync and
XStoreQueryAddOnLicensesAsync stay stubs: they need the store service.

Space Marine 2 retried XStoreCreateContext every minute or two while it
returned E_NOTIMPL.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../xgameruntime/GDKComponent/Ported/xstore.c | 165 ++++++++++++++++--
 1 file changed, 154 insertions(+), 11 deletions(-)

diff --git a/dlls/xgameruntime/GDKComponent/Ported/xstore.c b/dlls/xgameruntime/GDKComponent/Ported/xstore.c
index 1fdc3b8..c0c1a74 100644
--- a/dlls/xgameruntime/GDKComponent/Ported/xstore.c
+++ b/dlls/xgameruntime/GDKComponent/Ported/xstore.c
@@ -35,6 +35,122 @@ static inline struct x_store *impl_from_IXStoreImpl6( IXStoreImpl6 *iface )
     return CONTAINING_RECORD( iface, struct x_store, IXStoreImpl6_iface );
 }
 
+/* XStoreContextHandle: one per XStoreCreateContext call. */
+struct x_store_context
+{
+    XUserHandle user; /* NULL selects the default user */
+};
+
+/* Registration tokens handed out by XStoreRegisterGameLicenseChanged; never zero. */
+static LONG x_store_next_token;
+
+/*
+ * Async helper, the C counterpart of SaveAsyncContext in System/XGameSave.cpp: the work runs on its
+ * own thread and completes the XAsyncBlock afterwards. Completing from inside Begin would run the
+ * game's completion routine before XStore*Async returned, and XAsyncSchedule is avoided for the
+ * reasons noted in System/XUser.cpp. The job is owned by the provider from the moment XAsyncBegin
+ * succeeds and is freed in its Cleanup op.
+ */
+struct x_store_job
+{
+    XAsyncBlock *async;                                      /* engine-side block from Begin */
+    HRESULT (*work)( struct x_store_job *job );              /* worker thread; sets result_size on success */
+    void (*fill)( struct x_store_job *job, void *buffer );   /* caller's thread, inside GetResult */
+    SIZE_T result_size;
+    union
+    {
+        XStoreGameLicense license;
+    } result;
+};
+
+static DWORD WINAPI x_store_job_thread( void *param )
+{
+    struct x_store_job *job = param;
+    XAsyncBlock *async = job->async;
+    IXThreadingImpl *xthreading;
+    HRESULT hr = job->work ? job->work( job ) : S_OK;
+    SIZE_T size = SUCCEEDED( hr ) ? job->result_size : 0;
+
+    if (SUCCEEDED( QueryApiImpl( &CLSID_XThreadingImpl, &IID_IXThreadingImpl, (void **)&xthreading ) ))
+    {
+        IXThreadingImpl_XAsyncComplete( xthreading, async, hr, size ); /* may run Cleanup and free the job */
+        IXThreadingImpl_Release( xthreading );
+    }
+    return 0;
+}
+
+static HRESULT WINAPI x_store_job_provider( XAsyncOp op, const XAsyncProviderData *data )
+{
+    struct x_store_job *job = data->context;
+    HANDLE thread;
+
+    switch (op)
+    {
+    case XAsyncOp_Begin:
+        job->async = data->async;
+        if (!(thread = CreateThread( NULL, 0, x_store_job_thread, job, 0, NULL ))) return HRESULT_FROM_WIN32( GetLastError() );
+        CloseHandle( thread );
+        return S_OK;
+    case XAsyncOp_GetResult:
+        /* data->bufferSize >= result_size: XAsyncGetResult has already rejected smaller buffers */
+        if (job->fill) job->fill( job, data->buffer );
+        return S_OK;
+    case XAsyncOp_Cleanup:
+        free( job );
+        return S_OK;
+    default:
+        return S_OK;
+    }
+}
+
+static HRESULT x_store_begin_job( XAsyncBlock *async, const void *identity, const char *name, struct x_store_job *job )
+{
+    IXThreadingImpl *xthreading;
+    HRESULT hr;
+
+    if (!async) { free( job ); return E_POINTER; }
+    if (FAILED( hr = QueryApiImpl( &CLSID_XThreadingImpl, &IID_IXThreadingImpl, (void **)&xthreading ) )) { free( job ); return hr; }
+    hr = IXThreadingImpl_XAsyncBegin( xthreading, async, job, identity, name, x_store_job_provider );
+    IXThreadingImpl_Release( xthreading );
+    if (FAILED( hr )) free( job ); /* only then did the provider never see the job */
+    return hr;
+}
+
+static HRESULT x_store_get_job_result( XAsyncBlock *async, const void *identity, SIZE_T size, void *buffer, SIZE_T *used )
+{
+    IXThreadingImpl *xthreading;
+    HRESULT hr;
+
+    if (!async) return E_POINTER;
+    if (FAILED( hr = QueryApiImpl( &CLSID_XThreadingImpl, &IID_IXThreadingImpl, (void **)&xthreading ) )) return hr;
+    hr = IXThreadingImpl_XAsyncGetResult( xthreading, async, identity, size, buffer, used );
+    IXThreadingImpl_Release( xthreading );
+    return hr;
+}
+
+/* Identities are compared by address in XAsyncGetResult: one static object per Async/Result pair. */
+static const char x_store_game_license_identity[] = "XStoreQueryGameLicenseAsync";
+
+/* An installed Game Pass title holds a full, perpetual license: no trial, no disc, no expiry. */
+static HRESULT x_store_game_license_work( struct x_store_job *job )
+{
+    XStoreGameLicense *license = &job->result.license;
+    const char *store_id = gdk_store_id; /* <StoreId> of MicrosoftGame.config, "" when absent */
+
+    memset( license, 0, sizeof(*license) );
+    if (store_id) lstrcpynA( license->skuStoreId, store_id, sizeof(license->skuStoreId) );
+    license->isActive = TRUE;
+    /* isTrialOwnedByThisUser, isDiscLicense, isTrial, trialTimeRemainingInSeconds, trialUniqueId and
+     * expirationDate stay zero. */
+    job->result_size = sizeof(*license);
+    return S_OK;
+}
+
+static void x_store_game_license_fill( struct x_store_job *job, void *buffer )
+{
+    memcpy( buffer, &job->result.license, sizeof(job->result.license) );
+}
+
 static HRESULT WINAPI x_store_QueryInterface( IXStoreImpl6 *iface, REFIID iid, void **out )
 {
     struct x_store *impl = impl_from_IXStoreImpl6( iface );
@@ -76,13 +192,21 @@ static ULONG WINAPI x_store_Release( IXStoreImpl6 *iface )
 
 static HRESULT WINAPI x_store_XStoreCreateContext( IXStoreImpl6 *iface, const XUserHandle user, XStoreContextHandle *storeContextHandle )
 {
-    FIXME( "iface %p, user %p, storeContextHandle %p stub!\n", iface, user, storeContextHandle );
-    return E_NOTIMPL;
+    struct x_store_context *context;
+
+    TRACE( "iface %p, user %p, storeContextHandle %p.\n", iface, user, storeContextHandle );
+
+    if (!storeContextHandle) return E_POINTER;
+    if (!(context = calloc( 1, sizeof(*context) ))) return E_OUTOFMEMORY;
+    context->user = user;
+    *storeContextHandle = context;
+    return S_OK;
 }
 
 static void WINAPI x_store_XStoreCloseContextHandle( IXStoreImpl6 *iface, XStoreContextHandle storeContextHandle )
 {
-    FIXME( "iface %p, storeContextHandle %p stub!\n", iface, storeContextHandle );
+    TRACE( "iface %p, storeContextHandle %p.\n", iface, storeContextHandle );
+    free( storeContextHandle );
 }
 
 static HRESULT WINAPI x_store_XStoreQueryAssociatedProductsAsync( IXStoreImpl6 *iface, const XStoreContextHandle storeContextHandle, XStoreProductKind productKinds, UINT32 maxItemsToRetrievePerPage, XAsyncBlock *async )
@@ -223,14 +347,24 @@ static HRESULT WINAPI x_store_XStoreCanAcquireLicenseForPackageResult( IXStoreIm
 
 static HRESULT WINAPI x_store_XStoreQueryGameLicenseAsync( IXStoreImpl6 *iface, const XStoreContextHandle storeContextHandle, XAsyncBlock *async )
 {
-    FIXME( "iface %p, storeContextHandle %p, async %p stub!\n", iface, storeContextHandle, async );
-    return E_NOTIMPL;
+    struct x_store_job *job;
+
+    TRACE( "iface %p, storeContextHandle %p, async %p.\n", iface, storeContextHandle, async );
+
+    if (!storeContextHandle) return E_GAMERUNTIME_INVALID_HANDLE;
+    if (!async) return E_POINTER;
+    if (!(job = calloc( 1, sizeof(*job) ))) return E_OUTOFMEMORY;
+    job->work = x_store_game_license_work;
+    job->fill = x_store_game_license_fill;
+    return x_store_begin_job( async, x_store_game_license_identity, "XStoreQueryGameLicenseAsync", job );
 }
 
 static HRESULT WINAPI x_store_XStoreQueryGameLicenseResult( IXStoreImpl6 *iface, XAsyncBlock *async, XStoreGameLicense *license )
 {
-    FIXME( "iface %p, async %p, license %p stub!\n", iface, async, license );
-    return E_NOTIMPL;
+    TRACE( "iface %p, async %p, license %p.\n", iface, async, license );
+
+    if (!license) return E_POINTER;
+    return x_store_get_job_result( async, x_store_game_license_identity, sizeof(*license), license, NULL );
 }
 
 static HRESULT WINAPI x_store_XStoreQueryAddOnLicensesAsync( IXStoreImpl6 *iface, const XStoreContextHandle storeContextHandle, XAsyncBlock *async )
@@ -451,14 +585,23 @@ static HRESULT WINAPI x_store_XStoreQueryPackageIdentifier( IXStoreImpl6 *iface,
 
 static HRESULT WINAPI x_store_XStoreRegisterGameLicenseChanged( IXStoreImpl6 *iface, XStoreContextHandle storeContextHandle, XTaskQueueHandle queue, void *context, XStoreGameLicenseChangedCallback *callback, XTaskQueueRegistrationToken *token )
 {
-    FIXME( "iface %p, storeContextHandle %p, queue %p, context %p, callback %p, token %p stub!\n", iface, storeContextHandle, queue, context, callback, token );
-    return E_NOTIMPL;
+    TRACE( "iface %p, storeContextHandle %p, queue %p, context %p, callback %p, token %p.\n", iface, storeContextHandle, queue, context, callback, token );
+
+    if (!storeContextHandle) return E_GAMERUNTIME_INVALID_HANDLE;
+    if (!callback) return E_INVALIDARG;
+    if (!token) return E_POINTER;
+
+    /* The license reported by XStoreQueryGameLicenseAsync never changes while the title runs, so the
+     * callback is never invoked; the registration only has to succeed. */
+    token->token = InterlockedIncrement( &x_store_next_token );
+    return S_OK;
 }
 
 static BOOLEAN WINAPI x_store_XStoreUnregisterGameLicenseChanged( IXStoreImpl6 *iface, XStoreContextHandle storeContextHandle, XTaskQueueRegistrationToken token, BOOLEAN wait )
 {
-    FIXME( "iface %p, storeContextHandle %p, token %p, wait %d stub!\n", iface, storeContextHandle, &token, wait );
-    return FALSE;
+    /* Nothing was ever queued for the token (unknown tokens included), so there is nothing to wait for. */
+    TRACE( "iface %p, storeContextHandle %p, token %I64u, wait %d.\n", iface, storeContextHandle, token.token, wait );
+    return TRUE;
 }
 
 static HRESULT WINAPI x_store_XStoreRegisterPackageLicenseLost( IXStoreImpl6 *iface, XStoreLicenseHandle storeLicenseHandle, XTaskQueueHandle queue, void *context, XStorePackageLicenseLostCallback *callback, XTaskQueueRegistrationToken *token)
