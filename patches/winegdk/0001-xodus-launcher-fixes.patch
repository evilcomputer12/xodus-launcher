+    ULONG WINAPI
+    AddRef() noexcept override
+    {
+        ULONG curr = static_cast<ULONG>(++ref);
+        TRACE( "iface %p increasing refcount to %lu.\n", this, curr );
+        return curr;
+    }
+
+    ULONG WINAPI
+    Release() noexcept override
+    {
+        ULONG curr = static_cast<ULONG>(--ref);
+        TRACE( "iface %p decreasing refcount to %lu.\n", this, curr );
+        return curr;
+    }
+
+    HRESULT WINAPI XPersistentLocalStorageGetPathSize( SIZE_T *pathSize ) override
+    {
+        TRACE( "pathSize %p\n", pathSize );
+
+        if ( !pathSize ) return E_POINTER;
+        RETURN_IF_FAILED( EnsurePath() );
+
+        *pathSize = std::strlen( storagePath ) + 1;
+        return S_OK;
+    }
+
+    HRESULT WINAPI XPersistentLocalStorageGetPath( SIZE_T pathSize, char *path, SIZE_T *pathUsed ) override
+    {
+        SIZE_T needed;
+
+        TRACE( "pathSize %Iu, path %p, pathUsed %p\n", pathSize, path, pathUsed );
+
+        if ( !path ) return E_POINTER;
+        RETURN_IF_FAILED( EnsurePath() );
+
+        needed = std::strlen( storagePath ) + 1;
+        if ( pathSize < needed ) return HRESULT_FROM_WIN32( ERROR_INSUFFICIENT_BUFFER );
+
+        std::memcpy( path, storagePath, needed );
+        if ( pathUsed ) *pathUsed = needed;
+        return S_OK;
+    }
+
+    HRESULT WINAPI XPersistentLocalStorageGetSpaceInfo( XPersistentLocalStorageSpaceInfo *info ) override
+    {
+        ULARGE_INTEGER freeBytes;
+
+        TRACE( "info %p\n", info );
+
+        if ( !info ) return E_POINTER;
+        RETURN_IF_FAILED( EnsurePath() );
+
+        if ( !GetDiskFreeSpaceExA( storagePath, &freeBytes, NULL, NULL ) )
+            freeBytes.QuadPart = XPersistentLocalStorageDefaultBytes;
+
+        info->totalBytes = XPersistentLocalStorageDefaultBytes;
+        info->usedBytes = 0;
+        info->availableFreeBytes = min( freeBytes.QuadPart, XPersistentLocalStorageDefaultBytes );
+        info->totalFreeBytes = info->availableFreeBytes;
+        return S_OK;
+    }
