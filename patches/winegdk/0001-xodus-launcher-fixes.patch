+
+    HRESULT WINAPI XGameSaveInitializeProvider( XUserHandle requestingUser, const char *configurationId, BOOLEAN syncOnDemand, XGameSaveProviderHandle *provider ) override
+    {
+        TRACE( "requestingUser %p, configurationId %s, syncOnDemand %d, provider %p\n", requestingUser, debugstr_a( configurationId ), syncOnDemand, provider );
