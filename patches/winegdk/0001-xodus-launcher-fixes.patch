+    HRESULT WINAPI XGameSaveEnumerateBlobInfoByName( XGameSaveContainerHandle container, const char *blobNamePrefix, void *context, XGameSaveBlobInfoCallback *callback ) override
+    {
+        size_t prefixLen = blobNamePrefix ? strlen( blobNamePrefix ) : 0;
+
+        TRACE( "container %p, blobNamePrefix %s, context %p, callback %p\n", container, debugstr_a( blobNamePrefix ), context, callback );
+
+        if ( !container ) return E_GS_HANDLE_EXPIRED;
+        if ( !callback ) return E_INVALIDARG;
+        for ( auto &b : ListBlobs( ContainerDir( container ), nullptr ) )
+        {
+            if ( prefixLen && b.first.compare( 0, prefixLen, blobNamePrefix ) != 0 ) continue;
+            XGameSaveBlobInfo info{ b.first.c_str(), (UINT32)b.second };
+            if ( !callback( &info, context ) ) break;
+        }
+        return S_OK;
+    }
+
+    HRESULT WINAPI XGameSaveReadBlobData( XGameSaveContainerHandle container, const char **blobNames, UINT32 *countOfBlobs, SIZE_T blobsSize, XGameSaveBlob *blobData ) override
+    {
+        std::vector<std::pair<std::string, std::vector<UINT8>>> blobs;
+        HRESULT hr;
+
+        TRACE( "container %p, blobNames %p, countOfBlobs %p, blobsSize %Iu, blobData %p\n", container, blobNames, countOfBlobs, blobsSize, blobData );
+
+        if ( !container ) return E_GS_HANDLE_EXPIRED;
+        if ( !countOfBlobs || !blobData ) return E_POINTER;
+        if ( FAILED( hr = LoadBlobs( container, blobNames, *countOfBlobs, blobs ) ) ) return hr;
+        if ( blobsSize < PackedSize( blobs ) ) return E_GS_PROVIDED_BUFFER_TOO_SMALL;
+        PackBlobs( blobs, blobData );
+        *countOfBlobs = (UINT32)blobs.size();
+        return S_OK;
+    }
+
+    HRESULT WINAPI XGameSaveReadBlobDataAsync( XGameSaveContainerHandle container, const char **blobNames, UINT32 countOfBlobs, XAsyncBlock *async ) override
+    {
+        TRACE( "container %p, blobNames %p, countOfBlobs %u, async %p\n", container, blobNames, countOfBlobs, async );
+
+        if ( !container ) return E_GS_HANDLE_EXPIRED;
+        // copy the names now: the caller's array only has to live until this call returns
+        std::vector<std::string> names;
+        bool all = !blobNames;
+        for ( UINT32 i = 0; !all && i < countOfBlobs; i++ ) names.emplace_back( blobNames[i] );
+
+        auto ctx = new SaveAsyncContext();
+        auto blobs = std::make_shared<std::vector<std::pair<std::string, std::vector<UINT8>>>>();
+        ctx->work = [container, names, all, blobs]( SaveAsyncContext *c ) {
+            std::vector<const char *> ptrs;
+            for ( auto &n : names ) ptrs.push_back( n.c_str() );
+            HRESULT hr = LoadBlobs( container, all ? nullptr : ptrs.data(), (UINT32)ptrs.size(), *blobs );
+            c->resultSize = PackedSize( *blobs );
+            return hr;
+        };
+        ctx->fill = [blobs]( void *buffer ) { PackBlobs( *blobs, buffer ); };
+        return BeginSaveAsync( async, ReadIdentity, "XGameSaveReadBlobDataAsync", ctx );
+    }
+
+    HRESULT WINAPI XGameSaveReadBlobDataResult( XAsyncBlock *async, SIZE_T blobsSize, XGameSaveBlob *blobData, UINT32 *countOfBlobs ) override
+    {
+        SIZE_T used = 0;
+        HRESULT hr;
+
+        TRACE( "async %p, blobsSize %Iu, blobData %p, countOfBlobs %p\n", async, blobsSize, blobData, countOfBlobs );
+
+        if ( !blobData || !countOfBlobs ) return E_POINTER;
+        if ( FAILED( hr = GetSaveAsyncResult( async, ReadIdentity, blobsSize, blobData, &used ) ) ) return hr;
+        // names follow the XGameSaveBlob array, so the first name marks where the array ends
+        *countOfBlobs = used ? (UINT32)(((char *)blobData[0].info.name - (char *)blobData) / sizeof(XGameSaveBlob)) : 0;
+        return S_OK;
+    }
