+private:
+    // %LOCALAPPDATA%\XodusGames\<TitleId>\PersistentLocalStorage\ inside the prefix
+    HRESULT EnsurePath()
+    {
+        char base[MAX_PATH];
+        char dir[MAX_PATH];
+        DWORD len;
+
+        if ( storagePath[0] ) return S_OK;
+
+        len = GetEnvironmentVariableA( "LOCALAPPDATA", base, sizeof(base) );
+        if ( !len || len >= sizeof(base) ) return E_FAIL;
+
+        snprintf( dir, sizeof(dir), "%s\\XodusGames", base );
+        CreateDirectoryA( dir, NULL );
+        snprintf( dir, sizeof(dir), "%s\\XodusGames\\%08x", base, titleId );
+        CreateDirectoryA( dir, NULL );
+        snprintf( dir, sizeof(dir), "%s\\XodusGames\\%08x\\PersistentLocalStorage", base, titleId );
+        if ( !CreateDirectoryA( dir, NULL ) && GetLastError() != ERROR_ALREADY_EXISTS )
+            return HRESULT_FROM_WIN32( GetLastError() );
+
+        snprintf( storagePath, sizeof(storagePath), "%s\\", dir );
+        TRACE( "persistent local storage at %s\n", debugstr_a( storagePath ) );
+        return S_OK;
+    }
+
+    char storagePath[MAX_PATH] = {};
+    std::atomic_long ref{ 1 };
+};
