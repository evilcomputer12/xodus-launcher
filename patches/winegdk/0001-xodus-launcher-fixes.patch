+static const char QuotaIdentity[] = "XGameSaveGetRemainingQuotaAsync";
+static const char DeleteIdentity[] = "XGameSaveDeleteContainerAsync";
+static const char ReadIdentity[] = "XGameSaveReadBlobDataAsync";
+static const char SubmitIdentity[] = "XGameSaveSubmitUpdateAsync";
+static const char FilesFolderIdentity[] = "XGameSaveFilesGetFolderWithUiAsync";
