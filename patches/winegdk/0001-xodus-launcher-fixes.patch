+        if ( !provider ) return E_GS_HANDLE_EXPIRED;
+        if ( !containerName || !*containerName ) return E_GS_INVALID_CONTAINER_NAME;
+
+        XGameSaveContainer c{ provider, containerName };
+        std::string dir = ContainerDir( &c );
+        for ( auto &b : ListBlobs( dir, nullptr ) ) DeleteFileA( (dir + EncodeName( b.first.c_str() )).c_str() );
+        DeleteFileA( (dir + DisplayNameFile).c_str() );
+        RemoveDirectoryA( dir.c_str() );
