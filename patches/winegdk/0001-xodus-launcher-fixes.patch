+class XGameImpl :
+    public IXGameImpl3
+{
+public:
+    HRESULT WINAPI QueryInterface( REFIID iid, void **out )
+    {
+        TRACE( "iface %p, iid %s, out %p.\n", this, debugstr_guid( &iid ), out );
+
+        if (!out) return E_POINTER;
+        *out = nullptr;
+
+        if ( iid == __uuidof( IUnknown ) ||
+             iid == __uuidof( IXGameImpl ) ||
+             iid == __uuidof( IXGameImpl2 ) ||
+             iid == __uuidof( IXGameImpl3 ) )
+        {
+            AddRef();
+            *out = static_cast<IXGameImpl3 *>(this);
+            return S_OK;
+        }
+
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( &iid ) );
+        return E_NOINTERFACE;
+    }
+
+    ULONG WINAPI
+    AddRef() noexcept override
+    {
+        ULONG curr = static_cast<ULONG>(++ref);
+        TRACE( "iface %p increasing refcount to %lu.\n", this, curr );
+        return curr;
+    }
+
+    ULONG WINAPI
+    Release() noexcept override
+    {
+        ULONG curr = static_cast<ULONG>(--ref);
+        TRACE( "iface %p decreasing refcount to %lu.\n", this, curr );
+        return curr;
+    }
+
+    HRESULT WINAPI XGameGetXboxTitleId( UINT32 *id ) override
+    {
+        TRACE( "id %p, titleId %#x\n", id, titleId );
+
+        if ( !id ) return E_POINTER;
+        // titleId is read from MicrosoftGame.config when the runtime initializes
+        if ( !titleId ) return E_GAMERUNTIME_NOT_INITIALIZED;
+
+        *id = titleId;
+        return S_OK;
+    }
+
+    void WINAPI XLaunchNewGame( const char *exePath, const char *args, XUserHandle defaultUser ) override
+    {
+        FIXME( "exePath %s, args %s, defaultUser %p stub!\n", debugstr_a( exePath ), debugstr_a( args ), defaultUser );
+    }
+
+    HRESULT WINAPI XLaunchRestartOnCrash( const char *args, UINT32 reserved ) override
+    {
+        FIXME( "args %s, reserved %u stub!\n", debugstr_a( args ), reserved );
+        return S_OK;
+    }
+
+private:
+    std::atomic_long ref{ 1 };
+};
+
+static XGameImpl g_x_game;
+
+IXGameImpl3 *x_game = static_cast<IXGameImpl3*>(&g_x_game);
diff --git a/dlls/xgameruntime/GDKComponent/System/XGameSave.cpp b/dlls/xgameruntime/GDKComponent/System/XGameSave.cpp
