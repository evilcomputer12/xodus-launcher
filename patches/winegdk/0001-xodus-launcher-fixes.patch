index 0000000..0208cf4
--- /dev/null
+++ b/dlls/xgameruntime/GDKComponent/System/XGameSave.cpp
@@ -0,0 +1,731 @@
+/*
+ * Xbox Game runtime Library
+ *  GDK Component: System API -> XGameSave
+ *
+ * Game saves are kept locally inside the prefix:
+ *   %LOCALAPPDATA%\XodusGames\<TitleId>\GameSave\<container>\<blob>
+ * There is no cloud sync; every container is always reported as in sync.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "../../private.h"
+
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <functional>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+WINE_DEFAULT_DEBUG_CHANNEL(gdkc);
+
+#define E_GS_INVALID_CONTAINER_NAME     _HRESULT_TYPEDEF_(0x80830001L)
+#define E_GS_PROVIDED_BUFFER_TOO_SMALL  _HRESULT_TYPEDEF_(0x80830007L)
+#define E_GS_BLOB_NOT_FOUND             _HRESULT_TYPEDEF_(0x80830008L)
+#define E_GS_HANDLE_EXPIRED             _HRESULT_TYPEDEF_(0x8083000DL)
+
+static const INT64 GameSaveQuotaBytes = 256ll * 1024 * 1024;
+static const char DisplayNameFile[] = ".displayname";
+
+struct XGameSaveProvider
+{
+    std::string root;   // ...\GameSave\ (trailing backslash)
+};
+
+struct XGameSaveContainer
+{
+    XGameSaveProvider *provider;
+    std::string name;
+};
+
+struct XGameSaveUpdate
+{
+    XGameSaveContainer *container;
+    std::string displayName;
+    std::vector<std::pair<std::string, std::vector<UINT8>>> writes;
+    std::vector<std::string> deletes;
+};
+
+/* names may contain characters that are not valid in file names: percent-encode them */
+static std::string EncodeName( const char *name )
+{
+    std::string out;
+    char hex[4];
+
+    for ( const char *p = name; *p; p++ )
+    {
+        unsigned char c = (unsigned char)*p;
+        if ( (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
+             c == '-' || c == '_' || c == ' ' || c >= 0x80 )
+            out += (char)c;
+        else
+        {
+            snprintf( hex, sizeof(hex), "%%%02X", c );
+            out += hex;
+        }
+    }
+    return out;
+}
+
+static std::string DecodeName( const std::string &name )
+{
+    std::string out;
+
+    for ( size_t i = 0; i < name.size(); i++ )
+    {
+        if ( name[i] == '%' && i + 2 < name.size() )
+        {
+            out += (char)strtoul( name.substr( i + 1, 2 ).c_str(), nullptr, 16 );
+            i += 2;
+        }
+        else out += name[i];
+    }
+    return out;
+}
+
+static std::string TitleDir( const char *leaf )
+{
+    char base[MAX_PATH], dir[MAX_PATH];
+    DWORD len = GetEnvironmentVariableA( "LOCALAPPDATA", base, sizeof(base) );
+
+    if ( !len || len >= sizeof(base) ) return std::string();
+    snprintf( dir, sizeof(dir), "%s\\XodusGames", base );
+    CreateDirectoryA( dir, NULL );
+    snprintf( dir, sizeof(dir), "%s\\XodusGames\\%08x", base, titleId );
+    CreateDirectoryA( dir, NULL );
+    snprintf( dir, sizeof(dir), "%s\\XodusGames\\%08x\\%s", base, titleId, leaf );
+    CreateDirectoryA( dir, NULL );
+    return std::string( dir ) + "\\";
+}
+
+static std::string ContainerDir( XGameSaveContainer *c )
+{
+    return c->provider->root + EncodeName( c->name.c_str() ) + "\\";
+}
+
+static bool ReadWholeFile( const std::string &path, std::vector<UINT8> &data )
+{
+    HANDLE file = CreateFileA( path.c_str(), GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    LARGE_INTEGER size;
+    DWORD read;
+
+    if ( file == INVALID_HANDLE_VALUE ) return false;
+    if ( !GetFileSizeEx( file, &size ) ) { CloseHandle( file ); return false; }
+    data.resize( (size_t)size.QuadPart );
+    bool ok = !size.QuadPart || (ReadFile( file, data.data(), (DWORD)size.QuadPart, &read, NULL ) && read == size.QuadPart);
+    CloseHandle( file );
+    return ok;
+}
+
+static bool WriteWholeFile( const std::string &path, const UINT8 *data, size_t size )
+{
+    std::string tmp = path + ".tmp";
+    HANDLE file = CreateFileA( tmp.c_str(), GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL );
+    DWORD written;
+
+    if ( file == INVALID_HANDLE_VALUE ) return false;
+    bool ok = !size || (WriteFile( file, data, (DWORD)size, &written, NULL ) && written == size);
+    CloseHandle( file );
+    if ( !ok ) { DeleteFileA( tmp.c_str() ); return false; }
+    return MoveFileExA( tmp.c_str(), path.c_str(), MOVEFILE_REPLACE_EXISTING );
+}
+
+/* blob files of a container (decoded name, size), skipping our bookkeeping files */
+static std::vector<std::pair<std::string, UINT64>> ListBlobs( const std::string &dir, UINT64 *lastWrite )
+{
+    std::vector<std::pair<std::string, UINT64>> blobs;
+    WIN32_FIND_DATAA fd;
+    HANDLE find = FindFirstFileA( (dir + "*").c_str(), &fd );
+
+    if ( lastWrite ) *lastWrite = 0;
+    if ( find == INVALID_HANDLE_VALUE ) return blobs;
+    do
+    {
+        if ( fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY ) continue;
+        std::string name = fd.cFileName;
+        if ( name == DisplayNameFile || (name.size() > 4 && name.compare( name.size() - 4, 4, ".tmp" ) == 0) ) continue;
+        blobs.emplace_back( DecodeName( name ), ((UINT64)fd.nFileSizeHigh << 32) | fd.nFileSizeLow );
+        if ( lastWrite )
+        {
+            UINT64 t = ((UINT64)fd.ftLastWriteTime.dwHighDateTime << 32) | fd.ftLastWriteTime.dwLowDateTime;
+            if ( t > *lastWrite ) *lastWrite = t;
+        }
+    } while ( FindNextFileA( find, &fd ) );
+    FindClose( find );
+    return blobs;
+}
+
+static UINT64 FileTimeToUnix( UINT64 ft )
+{
+    return ft ? (ft - 116444736000000000ull) / 10000000ull : 0;
+}
+
+static bool ContainerExists( const std::string &dir )
+{
+    DWORD attr = GetFileAttributesA( dir.c_str() );
+    return attr != INVALID_FILE_ATTRIBUTES && (attr & FILE_ATTRIBUTE_DIRECTORY);
+}
+
+static HRESULT ReportContainer( XGameSaveProvider *provider, const std::string &encoded, void *context,
+                                XGameSaveContainerInfoCallback *callback, BOOLEAN *keepGoing )
+{
+    std::string dir = provider->root + encoded + "\\";
+    std::string name = DecodeName( encoded ), displayName;
+    std::vector<UINT8> dn;
+    UINT64 lastWrite, total = 0;
+    XGameSaveContainerInfo info;
+
+    auto blobs = ListBlobs( dir, &lastWrite );
+    for ( auto &b : blobs ) total += b.second;
+    if ( ReadWholeFile( dir + DisplayNameFile, dn ) ) displayName.assign( dn.begin(), dn.end() );
+
+    info.name = name.c_str();
+    info.displayName = displayName.c_str();
+    info.blobCount = (UINT32)blobs.size();
+    info.totalSize = total;
+    info.lastModifiedTime = FileTimeToUnix( lastWrite );
+    info.needsSync = FALSE;
+    *keepGoing = callback( &info, context );
+    return S_OK;
+}
+
+static INT64 UsedBytes( XGameSaveProvider *provider )
+{
+    WIN32_FIND_DATAA fd;
+    HANDLE find = FindFirstFileA( (provider->root + "*").c_str(), &fd );
+    INT64 used = 0;
+
+    if ( find == INVALID_HANDLE_VALUE ) return 0;
+    do
+    {
+        if ( !(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || fd.cFileName[0] == '.' ) continue;
+        for ( auto &b : ListBlobs( provider->root + fd.cFileName + "\\", nullptr ) ) used += b.second;
+    } while ( FindNextFileA( find, &fd ) );
+    FindClose( find );
+    return used;
+}
+
+/* reads blobs; blobNames == NULL means all blobs of the container */
+static HRESULT LoadBlobs( XGameSaveContainer *c, const char **blobNames, UINT32 count,
+                          std::vector<std::pair<std::string, std::vector<UINT8>>> &out )
+{
+    std::string dir = ContainerDir( c );
+
+    if ( !blobNames )
+    {
+        for ( auto &b : ListBlobs( dir, nullptr ) )
+        {
+            out.emplace_back( b.first, std::vector<UINT8>() );
+            if ( !ReadWholeFile( dir + EncodeName( b.first.c_str() ), out.back().second ) ) return E_FAIL;
+        }
+        return S_OK;
+    }
+    for ( UINT32 i = 0; i < count; i++ )
+    {
+        out.emplace_back( blobNames[i], std::vector<UINT8>() );
+        if ( !ReadWholeFile( dir + EncodeName( blobNames[i] ), out.back().second ) ) return E_GS_BLOB_NOT_FOUND;
+    }
+    return S_OK;
+}
+
+/* XGameSaveBlob array, then names, then data, all inside one caller buffer */
+static SIZE_T PackedSize( const std::vector<std::pair<std::string, std::vector<UINT8>>> &blobs )
+{
+    SIZE_T size = blobs.size() * sizeof(XGameSaveBlob);
+    for ( auto &b : blobs ) size += b.first.size() + 1 + b.second.size();
+    return size;
+}
+
+static void PackBlobs( const std::vector<std::pair<std::string, std::vector<UINT8>>> &blobs, void *buffer )
+{
+    XGameSaveBlob *array = (XGameSaveBlob *)buffer;
+    char *cursor = (char *)(array + blobs.size());
+
+    for ( size_t i = 0; i < blobs.size(); i++ )
+    {
+        memcpy( cursor, blobs[i].first.c_str(), blobs[i].first.size() + 1 );
+        array[i].info.name = cursor;
+        cursor += blobs[i].first.size() + 1;
+        if ( !blobs[i].second.empty() ) memcpy( cursor, blobs[i].second.data(), blobs[i].second.size() );
+        array[i].data = (UINT8 *)cursor;
+        array[i].info.size = (UINT32)blobs[i].second.size();
+        cursor += blobs[i].second.size();
+    }
+}
+
+static HRESULT ApplyUpdate( XGameSaveUpdate *u )
+{
+    std::string dir = ContainerDir( u->container );
+
+    CreateDirectoryA( dir.c_str(), NULL );
+    for ( auto &name : u->deletes ) DeleteFileA( (dir + EncodeName( name.c_str() )).c_str() );
+    for ( auto &w : u->writes )
+        if ( !WriteWholeFile( dir + EncodeName( w.first.c_str() ), w.second.data(), w.second.size() ) )
+            return HRESULT_FROM_WIN32( GetLastError() );
+    if ( !u->displayName.empty() )
+        WriteWholeFile( dir + DisplayNameFile, (const UINT8 *)u->displayName.data(), u->displayName.size() );
+    TRACE( "saved container %s (%Iu writes, %Iu deletes)\n", debugstr_a( u->container->name.c_str() ), u->writes.size(), u->deletes.size() );
+    return S_OK;
+}
+
+/*
+ * Async helper: work runs on its own thread and completes the XAsyncBlock afterwards. Completing
+ * from inside Begin would call the game's completion routine before XAsync*Async returned.
+ */
+struct SaveAsyncContext
+{
+    std::function<HRESULT(SaveAsyncContext *)> work;
+    std::function<void(void *buffer)> fill;
+    SIZE_T resultSize = 0;
+    XAsyncBlock *async = nullptr;
+};
+
+static DWORD WINAPI SaveAsyncThread( void *param )
+{
+    SaveAsyncContext *ctx = (SaveAsyncContext *)param;
+    IXThreadingImpl *xthreading;
+    HRESULT hr = ctx->work( ctx );
+
+    if ( SUCCEEDED( QueryApiImpl( &CLSID_XThreadingImpl, IID_IXThreadingImpl, (void **)&xthreading ) ) )
+    {
+        xthreading->XAsyncComplete( ctx->async, hr, SUCCEEDED(hr) ? ctx->resultSize : 0 );
+        xthreading->Release();
+    }
+    return 0;
+}
+
+static HRESULT WINAPI SaveAsyncProvider( XAsyncOp op, const XAsyncProviderData *data )
+{
+    SaveAsyncContext *ctx = (SaveAsyncContext *)data->context;
+
+    switch (op)
+    {
+        case XAsyncOp::Begin:
+        {
+            ctx->async = data->async;
+            HANDLE thread = CreateThread( nullptr, 0, SaveAsyncThread, ctx, 0, nullptr );
+            if ( !thread ) return HRESULT_FROM_WIN32( GetLastError() );
+            CloseHandle( thread );
+            return S_OK;
+        }
+        case XAsyncOp::GetResult:
+            if ( ctx->fill ) ctx->fill( data->buffer );
+            return S_OK;
+        case XAsyncOp::Cleanup:
+            delete ctx;
+            return S_OK;
+        default:
+            return S_OK;
+    }
+}
+
+static HRESULT BeginSaveAsync( XAsyncBlock *async, const void *identity, const char *name, SaveAsyncContext *ctx )
+{
+    IXThreadingImpl *xthreading;
+    HRESULT hr;
+
+    if ( !async ) { delete ctx; return E_POINTER; }
+    if ( FAILED( hr = QueryApiImpl( &CLSID_XThreadingImpl, IID_IXThreadingImpl, (void **)&xthreading ) ) ) { delete ctx; return hr; }
+    hr = xthreading->XAsyncBegin( async, ctx, identity, name, SaveAsyncProvider );
+    xthreading->Release();
+    if ( FAILED( hr ) ) delete ctx;
+    return hr;
+}
+
+static HRESULT GetSaveAsyncResult( XAsyncBlock *async, const void *identity, SIZE_T size, void *buffer, SIZE_T *used )
+{
+    IXThreadingImpl *xthreading;
+    HRESULT hr;
+
+    if ( FAILED( hr = QueryApiImpl( &CLSID_XThreadingImpl, IID_IXThreadingImpl, (void **)&xthreading ) ) ) return hr;
+    hr = xthreading->XAsyncGetResult( async, identity, size, buffer, used );
+    xthreading->Release();
+    return hr;
+}
