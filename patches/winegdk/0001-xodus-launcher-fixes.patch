+/*
+ * Offline local player. Real Xbox Live sign-in (through xodus-service) is not wired up yet, so
+ * games get a single always-signed-in local user and keep working offline.
+ */
+static XUser g_offline_user = { X_USER_SIGNATURE, nullptr };
+static const UINT64 OfflineUserLocalId = 1;
+static const UINT64 OfflineUserXuid = 0x0009000000000001ull;
+static const char XUserAddAsyncIdentity[] = "XUserAddAsync";
+
+static BOOL IsOfflineUser( XUserHandle user )
+{
+    return user == &g_offline_user;
+}
+
+static DWORD WINAPI
+OfflineUserAddCompleteThread( void *param )
+{
+    XAsyncBlock *async = (XAsyncBlock *)param;
+    IXThreadingImpl *xthreading;
+
+    Sleep( 50 );
+    if ( SUCCEEDED( QueryApiImpl( &CLSID_XThreadingImpl, IID_IXThreadingImpl, (void **)&xthreading ) ) )
+    {
+        xthreading->XAsyncComplete( async, S_OK, sizeof(XUserHandle) );
+        xthreading->Release();
+    }
+    return 0;
+}
+
+static HRESULT WINAPI
+OfflineUserAddProvider( XAsyncOp op, const XAsyncProviderData *data )
+{
+    IXThreadingImpl *xthreading;
+    HRESULT hr = S_OK;
+
+    TRACE( "op %d, data %p.\n", (int)op, data );
+
+    switch (op)
+    {
+        case XAsyncOp::Begin:
+        {
+            // Complete from another thread: games set up the state their completion callback uses
+            // after XUserAddAsync returns, so completing inside Begin re-enters them too early.
+            // (WineGDK's XAsyncSchedule path currently throws, so it is avoided here.)
+            HANDLE thread = CreateThread( nullptr, 0, OfflineUserAddCompleteThread, data->async, 0, nullptr );
+            if ( !thread ) return HRESULT_FROM_WIN32( GetLastError() );
+            CloseHandle( thread );
+            break;
+        }
+
+        case XAsyncOp::GetResult:
+            *(XUserHandle *)data->buffer = &g_offline_user;
+            break;
+
+        default:
+            break;
+    }
+
+    return hr;
+}
