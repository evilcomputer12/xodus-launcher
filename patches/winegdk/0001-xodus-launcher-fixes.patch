+    HRESULT WINAPI XGameSaveSubmitBlobWrite( XGameSaveUpdateHandle updateContext, const char *blobName, UINT8 *data, SIZE_T byteCount ) override
+    {
+        TRACE( "updateContext %p, blobName %s, data %p, byteCount %Iu\n", updateContext, debugstr_a( blobName ), data, byteCount );
+
+        if ( !updateContext ) return E_GS_HANDLE_EXPIRED;
+        if ( !blobName || (!data && byteCount) ) return E_INVALIDARG;
+        updateContext->writes.emplace_back( blobName, std::vector<UINT8>( data, data + byteCount ) );
+        return S_OK;
+    }
+
+    HRESULT WINAPI XGameSaveSubmitBlobDelete( XGameSaveUpdateHandle updateContext, const char *blobName ) override
+    {
+        TRACE( "updateContext %p, blobName %s\n", updateContext, debugstr_a( blobName ) );
+
+        if ( !updateContext ) return E_GS_HANDLE_EXPIRED;
+        if ( !blobName ) return E_INVALIDARG;
+        updateContext->deletes.emplace_back( blobName );
+        return S_OK;
+    }
+
+    HRESULT WINAPI XGameSaveSubmitUpdate( XGameSaveUpdateHandle updateContext ) override
+    {
+        TRACE( "updateContext %p\n", updateContext );
+        if ( !updateContext ) return E_GS_HANDLE_EXPIRED;
+        return ApplyUpdate( updateContext );
+    }
+
+    HRESULT WINAPI XGameSaveSubmitUpdateAsync( XGameSaveUpdateHandle updateContext, XAsyncBlock *async ) override
+    {
+        TRACE( "updateContext %p, async %p\n", updateContext, async );
+
+        if ( !updateContext ) return E_GS_HANDLE_EXPIRED;
+        // snapshot the update: the game may close the handle before the work runs
+        auto snapshot = std::make_shared<XGameSaveUpdate>( *updateContext );
+        auto container = std::make_shared<XGameSaveContainer>( *updateContext->container );
+        snapshot->container = container.get();
+
+        auto ctx = new SaveAsyncContext();
+        ctx->work = [snapshot, container]( SaveAsyncContext * ) { return ApplyUpdate( snapshot.get() ); };
+        return BeginSaveAsync( async, SubmitIdentity, "XGameSaveSubmitUpdateAsync", ctx );
+    }
+
+    HRESULT WINAPI XGameSaveSubmitUpdateResult( XAsyncBlock *async ) override
+    {
+        TRACE( "async %p\n", async );
+        return GetSaveAsyncResult( async, SubmitIdentity, 0, nullptr, nullptr );
+    }
