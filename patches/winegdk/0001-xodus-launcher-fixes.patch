+    HRESULT WINAPI XGameSaveEnumerateContainerInfoByName( XGameSaveProviderHandle provider, const char *containerNamePrefix, void *context, XGameSaveContainerInfoCallback *callback ) override
+    {
+        WIN32_FIND_DATAA fd;
+        BOOLEAN keepGoing = TRUE;
+        size_t prefixLen = containerNamePrefix ? strlen( containerNamePrefix ) : 0;
+
+        TRACE( "provider %p, containerNamePrefix %s, context %p, callback %p\n", provider, debugstr_a( containerNamePrefix ), context, callback );
+
+        if ( !provider ) return E_GS_HANDLE_EXPIRED;
+        if ( !callback ) return E_INVALIDARG;
+
+        HANDLE find = FindFirstFileA( (provider->root + "*").c_str(), &fd );
+        if ( find == INVALID_HANDLE_VALUE ) return S_OK;
+        do
+        {
+            if ( !(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || fd.cFileName[0] == '.' ) continue;
+            if ( prefixLen && DecodeName( fd.cFileName ).compare( 0, prefixLen, containerNamePrefix ) != 0 ) continue;
+            ReportContainer( provider, fd.cFileName, context, callback, &keepGoing );
+        } while ( keepGoing && FindNextFileA( find, &fd ) );
+        FindClose( find );
+        return S_OK;
+    }
