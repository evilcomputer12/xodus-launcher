+        *out = nullptr;
+
+        if ( iid == __uuidof( IUnknown ) ||
+             iid == __uuidof( IXPersistentLocalStorageImpl ) ||
+             iid == __uuidof( IXPersistentLocalStorageImpl2 ) ||
+             iid == __uuidof( IXPersistentLocalStorageImpl3 ) )
+        {
