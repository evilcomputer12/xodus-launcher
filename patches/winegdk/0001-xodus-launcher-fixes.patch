+        TRACE( "provider %p, containerName %s, context %p, callback %p\n", provider, debugstr_a( containerName ), context, callback );
+
+        if ( !provider ) return E_GS_HANDLE_EXPIRED;
+        if ( !containerName || !callback ) return E_INVALIDARG;
+        std::string encoded = EncodeName( containerName );
+        if ( !ContainerExists( provider->root + encoded ) ) return S_OK;  // no callback for missing containers
+        return ReportContainer( provider, encoded, context, callback, &keepGoing );
+    }
