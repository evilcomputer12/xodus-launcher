+    HRESULT WINAPI XGameSaveFilesGetRemainingQuota( XUserHandle userContext, const char *configurationId, INT64 *remainingQuota ) override
+    {
+        TRACE( "userContext %p, configurationId %s, remainingQuota %p\n", userContext, debugstr_a( configurationId ), remainingQuota );
+        if ( !remainingQuota ) return E_POINTER;
+        *remainingQuota = GameSaveQuotaBytes;
+        return S_OK;
+    }
+
