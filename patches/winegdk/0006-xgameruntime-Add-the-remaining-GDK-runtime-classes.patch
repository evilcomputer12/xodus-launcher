+#include <atomic>
+#include <cstdio>
+#include <cstring>
+
+WINE_DEFAULT_DEBUG_CHANNEL(gdkc);
+
+// Matches the default PersistentLocalStorage size games request in MicrosoftGame.config
+const UINT64 XPersistentLocalStorageDefaultBytes = 256ull * 1024 * 1024;
+
+class XPersistentLocalStorageImpl :
+    public IXPersistentLocalStorageImpl3
+{
+public:
+    HRESULT WINAPI QueryInterface( REFIID iid, void **out )
+    {
+        TRACE( "iface %p, iid %s, out %p.\n", this, debugstr_guid( &iid ), out );
+
+        if (!out) return E_POINTER;
+        *out = nullptr;
+
+        if ( iid == __uuidof( IUnknown ) ||
+             iid == __uuidof( IXPersistentLocalStorageImpl ) ||
+             iid == __uuidof( IXPersistentLocalStorageImpl2 ) ||
+             iid == __uuidof( IXPersistentLocalStorageImpl3 ) )
+        {
+            AddRef();
+            *out = static_cast<IXPersistentLocalStorageImpl3 *>(this);
+            return S_OK;
+        }
+
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( &iid ) );
+        return E_NOINTERFACE;
+    }
+
+    ULONG WINAPI
+    AddRef() noexcept override
+    {
+        ULONG curr = static_cast<ULONG>(++ref);
+        TRACE( "iface %p increasing refcount to %lu.\n", this, curr );
+        return curr;
+    }
+
+    ULONG WINAPI
+    Release() noexcept override
+    {
+        ULONG curr = static_cast<ULONG>(--ref);
+        TRACE( "iface %p decreasing refcount to %lu.\n", this, curr );
+        return curr;
+    }
+
+    HRESULT WINAPI XPersistentLocalStorageGetPathSize( SIZE_T *pathSize ) override
+    {
+        TRACE( "pathSize %p\n", pathSize );
+
+        if ( !pathSize ) return E_POINTER;
+        RETURN_IF_FAILED( EnsurePath() );
+
+        *pathSize = std::strlen( storagePath ) + 1;
+        return S_OK;
+    }
+
+    HRESULT WINAPI XPersistentLocalStorageGetPath( SIZE_T pathSize, char *path, SIZE_T *pathUsed ) override
+    {
+        SIZE_T needed;
+
+        TRACE( "pathSize %Iu, path %p, pathUsed %p\n", pathSize, path, pathUsed );
+
+        if ( !path ) return E_POINTER;
+        RETURN_IF_FAILED( EnsurePath() );
+
+        needed = std::strlen( storagePath ) + 1;
+        if ( pathSize < needed ) return HRESULT_FROM_WIN32( ERROR_INSUFFICIENT_BUFFER );
+
+        std::memcpy( path, storagePath, needed );
+        if ( pathUsed ) *pathUsed = needed;
+        return S_OK;
+    }
+
+    HRESULT WINAPI XPersistentLocalStorageGetSpaceInfo( XPersistentLocalStorageSpaceInfo *info ) override
+    {
+        ULARGE_INTEGER freeBytes;
+
+        TRACE( "info %p\n", info );
+
+        if ( !info ) return E_POINTER;
+        RETURN_IF_FAILED( EnsurePath() );
+
+        if ( !GetDiskFreeSpaceExA( storagePath, &freeBytes, NULL, NULL ) )
+            freeBytes.QuadPart = XPersistentLocalStorageDefaultBytes;
+
+        info->totalBytes = XPersistentLocalStorageDefaultBytes;
+        info->usedBytes = 0;
+        info->availableFreeBytes = min( freeBytes.QuadPart, XPersistentLocalStorageDefaultBytes );
+        info->totalFreeBytes = info->availableFreeBytes;
+        return S_OK;
+    }
+
+    HRESULT WINAPI XPersistentLocalStoragePromptUserForSpaceAsync( UINT64 requestedBytes, XAsyncBlock *asyncBlock ) override
+    {
+        FIXME( "requestedBytes %I64u, asyncBlock %p stub!\n", requestedBytes, asyncBlock );
+        return E_NOTIMPL;
+    }
+
+    HRESULT WINAPI XPersistentLocalStoragePromptUserForSpaceResult( XAsyncBlock *asyncBlock ) override
+    {
+        FIXME( "asyncBlock %p stub!\n", asyncBlock );
+        return E_NOTIMPL;
+    }
+
+    HRESULT WINAPI XPersistentLocalStorageMountForPackage( const char *packageIdentifier, XPackageMountHandle *mountHandle ) override
+    {
+        FIXME( "packageIdentifier %s, mountHandle %p stub!\n", debugstr_a( packageIdentifier ), mountHandle );
+        return E_NOTIMPL;
+    }
+
+private:
+    // %LOCALAPPDATA%\XodusGames\<TitleId>\PersistentLocalStorage\ inside the prefix
+    HRESULT EnsurePath()
+    {
+        char base[MAX_PATH];
+        char dir[MAX_PATH];
+        DWORD len;
+
+        if ( storagePath[0] ) return S_OK;
+
+        len = GetEnvironmentVariableA( "LOCALAPPDATA", base, sizeof(base) );
+        if ( !len || len >= sizeof(base) ) return E_FAIL;
+
+        snprintf( dir, sizeof(dir), "%s\\XodusGames", base );
+        CreateDirectoryA( dir, NULL );
+        snprintf( dir, sizeof(dir), "%s\\XodusGames\\%08x", base, titleId );
+        CreateDirectoryA( dir, NULL );
+        snprintf( dir, sizeof(dir), "%s\\XodusGames\\%08x\\PersistentLocalStorage", base, titleId );
+        if ( !CreateDirectoryA( dir, NULL ) && GetLastError() != ERROR_ALREADY_EXISTS )
+            return HRESULT_FROM_WIN32( GetLastError() );
+
+        snprintf( storagePath, sizeof(storagePath), "%s\\", dir );
+        TRACE( "persistent local storage at %s\n", debugstr_a( storagePath ) );
+        return S_OK;
+    }
+
+    char storagePath[MAX_PATH] = {};
+    std::atomic_long ref{ 1 };
+};
+
+static XPersistentLocalStorageImpl g_x_persistent_local_storage;
+
+IXPersistentLocalStorageImpl3 *x_persistent_local_storage = static_cast<IXPersistentLocalStorageImpl3*>(&g_x_persistent_local_storage);
