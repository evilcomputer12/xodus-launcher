+
+class XGameImpl :
+    public IXGameImpl3
+{
+public:
+    HRESULT WINAPI QueryInterface( REFIID iid, void **out )
+    {
+        TRACE( "iface %p, iid %s, out %p.\n", this, debugstr_guid( &iid ), out );
+
+        if (!out) return E_POINTER;
+        *out = nullptr;
+
+        if ( iid == __uuidof( IUnknown ) ||
+             iid == __uuidof( IXGameImpl ) ||
+             iid == __uuidof( IXGameImpl2 ) ||
+             iid == __uuidof( IXGameImpl3 ) )
+        {
+            AddRef();
+            *out = static_cast<IXGameImpl3 *>(this);
+            return S_OK;
+        }
+
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( &iid ) );
+        return E_NOINTERFACE;
+    }
+
+    ULONG WINAPI
+    AddRef() noexcept override
+    {
+        ULONG curr = static_cast<ULONG>(++ref);
+        TRACE( "iface %p increasing refcount to %lu.\n", this, curr );
+        return curr;
+    }
+
+    ULONG WINAPI
+    Release() noexcept override
+    {
+        ULONG curr = static_cast<ULONG>(--ref);
+        TRACE( "iface %p decreasing refcount to %lu.\n", this, curr );
+        return curr;
+    }
+
+    HRESULT WINAPI XGameGetXboxTitleId( UINT32 *id ) override
+    {
+        TRACE( "id %p, titleId %#x\n", id, titleId );
+
+        if ( !id ) return E_POINTER;
+        // titleId is read from MicrosoftGame.config when the runtime initializes
+        if ( !titleId ) return E_GAMERUNTIME_NOT_INITIALIZED;
+
+        *id = titleId;
+        return S_OK;
+    }
+
+    void WINAPI XLaunchNewGame( const char *exePath, const char *args, XUserHandle defaultUser ) override
+    {
+        FIXME( "exePath %s, args %s, defaultUser %p stub!\n", debugstr_a( exePath ), debugstr_a( args ), defaultUser );
+    }
+
+    HRESULT WINAPI XLaunchRestartOnCrash( const char *args, UINT32 reserved ) override
+    {
+        FIXME( "args %s, reserved %u stub!\n", debugstr_a( args ), reserved );
+        return S_OK;
+    }
+
+private:
+    std::atomic_long ref{ 1 };
+};
+
+static XGameImpl g_x_game;
+
+IXGameImpl3 *x_game = static_cast<IXGameImpl3*>(&g_x_game);
diff --git a/dlls/xgameruntime/GDKComponent/System/XGameSave.cpp b/dlls/xgameruntime/GDKComponent/System/XGameSave.cpp
new file mode 100644
index 0000000..0208cf4
--- /dev/null
+++ b/dlls/xgameruntime/GDKComponent/System/XGameSave.cpp
@@ -0,0 +1,731 @@
+/*
+ * Xbox Game runtime Library
+ *  GDK Component: System API -> XGameSave
+ *
+ * Game saves are kept locally inside the prefix:
+ *   %LOCALAPPDATA%\XodusGames\<TitleId>\GameSave\<container>\<blob>
+ * There is no cloud sync; every container is always reported as in sync.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "../../private.h"
+
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <functional>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+WINE_DEFAULT_DEBUG_CHANNEL(gdkc);
+
+#define E_GS_INVALID_CONTAINER_NAME     _HRESULT_TYPEDEF_(0x80830001L)
+#define E_GS_PROVIDED_BUFFER_TOO_SMALL  _HRESULT_TYPEDEF_(0x80830007L)
+#define E_GS_BLOB_NOT_FOUND             _HRESULT_TYPEDEF_(0x80830008L)
+#define E_GS_HANDLE_EXPIRED             _HRESULT_TYPEDEF_(0x8083000DL)
+
+static const INT64 GameSaveQuotaBytes = 256ll * 1024 * 1024;
+static const char DisplayNameFile[] = ".displayname";
+
+struct XGameSaveProvider
+{
+    std::string root;   // ...\GameSave\ (trailing backslash)
+};
+
+struct XGameSaveContainer
+{
+    XGameSaveProvider *provider;
+    std::string name;
+};
+
+struct XGameSaveUpdate
+{
+    XGameSaveContainer *container;
+    std::string displayName;
+    std::vector<std::pair<std::string, std::vector<UINT8>>> writes;
+    std::vector<std::string> deletes;
+};
+
+/* names may contain characters that are not valid in file names: percent-encode them */
+static std::string EncodeName( const char *name )
+{
+    std::string out;
+    char hex[4];
+
+    for ( const char *p = name; *p; p++ )
+    {
+        unsigned char c = (unsigned char)*p;
+        if ( (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
+             c == '-' || c == '_' || c == ' ' || c >= 0x80 )
+            out += (char)c;
+        else
+        {
+            snprintf( hex, sizeof(hex), "%%%02X", c );
+            out += hex;
+        }
+    }
+    return out;
+}
+
+static std::string DecodeName( const std::string &name )
+{
+    std::string out;
+
+    for ( size_t i = 0; i < name.size(); i++ )
+    {
+        if ( name[i] == '%' && i + 2 < name.size() )
+        {
+            out += (char)strtoul( name.substr( i + 1, 2 ).c_str(), nullptr, 16 );
+            i += 2;
+        }
+        else out += name[i];
+    }
+    return out;
+}
+
+static std::string TitleDir( const char *leaf )
+{
+    char base[MAX_PATH], dir[MAX_PATH];
+    DWORD len = GetEnvironmentVariableA( "LOCALAPPDATA", base, sizeof(base) );
+
+    if ( !len || len >= sizeof(base) ) return std::string();
+    snprintf( dir, sizeof(dir), "%s\\XodusGames", base );
+    CreateDirectoryA( dir, NULL );
+    snprintf( dir, sizeof(dir), "%s\\XodusGames\\%08x", base, titleId );
+    CreateDirectoryA( dir, NULL );
+    snprintf( dir, sizeof(dir), "%s\\XodusGames\\%08x\\%s", base, titleId, leaf );
+    CreateDirectoryA( dir, NULL );
+    return std::string( dir ) + "\\";
+}
+
+static std::string ContainerDir( XGameSaveContainer *c )
+{
+    return c->provider->root + EncodeName( c->name.c_str() ) + "\\";
+}
+
+static bool ReadWholeFile( const std::string &path, std::vector<UINT8> &data )
+{
+    HANDLE file = CreateFileA( path.c_str(), GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    LARGE_INTEGER size;
+    DWORD read;
+
+    if ( file == INVALID_HANDLE_VALUE ) return false;
+    if ( !GetFileSizeEx( file, &size ) ) { CloseHandle( file ); return false; }
+    data.resize( (size_t)size.QuadPart );
+    bool ok = !size.QuadPart || (ReadFile( file, data.data(), (DWORD)size.QuadPart, &read, NULL ) && read == size.QuadPart);
+    CloseHandle( file );
+    return ok;
+}
+
+static bool WriteWholeFile( const std::string &path, const UINT8 *data, size_t size )
+{
+    std::string tmp = path + ".tmp";
+    HANDLE file = CreateFileA( tmp.c_str(), GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL );
+    DWORD written;
+
+    if ( file == INVALID_HANDLE_VALUE ) return false;
+    bool ok = !size || (WriteFile( file, data, (DWORD)size, &written, NULL ) && written == size);
+    CloseHandle( file );
+    if ( !ok ) { DeleteFileA( tmp.c_str() ); return false; }
+    return MoveFileExA( tmp.c_str(), path.c_str(), MOVEFILE_REPLACE_EXISTING );
+}
+
+/* blob files of a container (decoded name, size), skipping our bookkeeping files */
+static std::vector<std::pair<std::string, UINT64>> ListBlobs( const std::string &dir, UINT64 *lastWrite )
+{
+    std::vector<std::pair<std::string, UINT64>> blobs;
+    WIN32_FIND_DATAA fd;
+    HANDLE find = FindFirstFileA( (dir + "*").c_str(), &fd );
+
+    if ( lastWrite ) *lastWrite = 0;
+    if ( find == INVALID_HANDLE_VALUE ) return blobs;
+    do
+    {
+        if ( fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY ) continue;
+        std::string name = fd.cFileName;
+        if ( name == DisplayNameFile || (name.size() > 4 && name.compare( name.size() - 4, 4, ".tmp" ) == 0) ) continue;
+        blobs.emplace_back( DecodeName( name ), ((UINT64)fd.nFileSizeHigh << 32) | fd.nFileSizeLow );
+        if ( lastWrite )
+        {
+            UINT64 t = ((UINT64)fd.ftLastWriteTime.dwHighDateTime << 32) | fd.ftLastWriteTime.dwLowDateTime;
+            if ( t > *lastWrite ) *lastWrite = t;
+        }
+    } while ( FindNextFileA( find, &fd ) );
+    FindClose( find );
+    return blobs;
+}
+
+static UINT64 FileTimeToUnix( UINT64 ft )
+{
+    return ft ? (ft - 116444736000000000ull) / 10000000ull : 0;
+}
+
+static bool ContainerExists( const std::string &dir )
+{
+    DWORD attr = GetFileAttributesA( dir.c_str() );
+    return attr != INVALID_FILE_ATTRIBUTES && (attr & FILE_ATTRIBUTE_DIRECTORY);
+}
+
+static HRESULT ReportContainer( XGameSaveProvider *provider, const std::string &encoded, void *context,
+                                XGameSaveContainerInfoCallback *callback, BOOLEAN *keepGoing )
+{
+    std::string dir = provider->root + encoded + "\\";
+    std::string name = DecodeName( encoded ), displayName;
+    std::vector<UINT8> dn;
+    UINT64 lastWrite, total = 0;
+    XGameSaveContainerInfo info;
+
+    auto blobs = ListBlobs( dir, &lastWrite );
+    for ( auto &b : blobs ) total += b.second;
+    if ( ReadWholeFile( dir + DisplayNameFile, dn ) ) displayName.assign( dn.begin(), dn.end() );
+
+    info.name = name.c_str();
+    info.displayName = displayName.c_str();
+    info.blobCount = (UINT32)blobs.size();
+    info.totalSize = total;
+    info.lastModifiedTime = FileTimeToUnix( lastWrite );
+    info.needsSync = FALSE;
+    *keepGoing = callback( &info, context );
+    return S_OK;
+}
+
+static INT64 UsedBytes( XGameSaveProvider *provider )
+{
+    WIN32_FIND_DATAA fd;
+    HANDLE find = FindFirstFileA( (provider->root + "*").c_str(), &fd );
+    INT64 used = 0;
+
+    if ( find == INVALID_HANDLE_VALUE ) return 0;
+    do
+    {
+        if ( !(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || fd.cFileName[0] == '.' ) continue;
+        for ( auto &b : ListBlobs( provider->root + fd.cFileName + "\\", nullptr ) ) used += b.second;
+    } while ( FindNextFileA( find, &fd ) );
+    FindClose( find );
+    return used;
+}
+
+/* reads blobs; blobNames == NULL means all blobs of the container */
+static HRESULT LoadBlobs( XGameSaveContainer *c, const char **blobNames, UINT32 count,
+                          std::vector<std::pair<std::string, std::vector<UINT8>>> &out )
+{
+    std::string dir = ContainerDir( c );
+
+    if ( !blobNames )
+    {
+        for ( auto &b : ListBlobs( dir, nullptr ) )
+        {
+            out.emplace_back( b.first, std::vector<UINT8>() );
+            if ( !ReadWholeFile( dir + EncodeName( b.first.c_str() ), out.back().second ) ) return E_FAIL;
+        }
+        return S_OK;
+    }
+    for ( UINT32 i = 0; i < count; i++ )
+    {
+        out.emplace_back( blobNames[i], std::vector<UINT8>() );
+        if ( !ReadWholeFile( dir + EncodeName( blobNames[i] ), out.back().second ) ) return E_GS_BLOB_NOT_FOUND;
+    }
+    return S_OK;
+}
+
+/* XGameSaveBlob array, then names, then data, all inside one caller buffer */
+static SIZE_T PackedSize( const std::vector<std::pair<std::string, std::vector<UINT8>>> &blobs )
+{
+    SIZE_T size = blobs.size() * sizeof(XGameSaveBlob);
+    for ( auto &b : blobs ) size += b.first.size() + 1 + b.second.size();
+    return size;
+}
+
+static void PackBlobs( const std::vector<std::pair<std::string, std::vector<UINT8>>> &blobs, void *buffer )
+{
+    XGameSaveBlob *array = (XGameSaveBlob *)buffer;
+    char *cursor = (char *)(array + blobs.size());
+
+    for ( size_t i = 0; i < blobs.size(); i++ )
+    {
+        memcpy( cursor, blobs[i].first.c_str(), blobs[i].first.size() + 1 );
+        array[i].info.name = cursor;
+        cursor += blobs[i].first.size() + 1;
+        if ( !blobs[i].second.empty() ) memcpy( cursor, blobs[i].second.data(), blobs[i].second.size() );
+        array[i].data = (UINT8 *)cursor;
+        array[i].info.size = (UINT32)blobs[i].second.size();
+        cursor += blobs[i].second.size();
+    }
+}
+
+static HRESULT ApplyUpdate( XGameSaveUpdate *u )
+{
+    std::string dir = ContainerDir( u->container );
+
+    CreateDirectoryA( dir.c_str(), NULL );
+    for ( auto &name : u->deletes ) DeleteFileA( (dir + EncodeName( name.c_str() )).c_str() );
+    for ( auto &w : u->writes )
+        if ( !WriteWholeFile( dir + EncodeName( w.first.c_str() ), w.second.data(), w.second.size() ) )
+            return HRESULT_FROM_WIN32( GetLastError() );
+    if ( !u->displayName.empty() )
+        WriteWholeFile( dir + DisplayNameFile, (const UINT8 *)u->displayName.data(), u->displayName.size() );
+    TRACE( "saved container %s (%Iu writes, %Iu deletes)\n", debugstr_a( u->container->name.c_str() ), u->writes.size(), u->deletes.size() );
+    return S_OK;
+}
+
+/*
+ * Async helper: work runs on its own thread and completes the XAsyncBlock afterwards. Completing
+ * from inside Begin would call the game's completion routine before XAsync*Async returned.
+ */
+struct SaveAsyncContext
+{
+    std::function<HRESULT(SaveAsyncContext *)> work;
+    std::function<void(void *buffer)> fill;
+    SIZE_T resultSize = 0;
+    XAsyncBlock *async = nullptr;
+};
+
+static DWORD WINAPI SaveAsyncThread( void *param )
+{
+    SaveAsyncContext *ctx = (SaveAsyncContext *)param;
+    IXThreadingImpl *xthreading;
+    HRESULT hr = ctx->work( ctx );
+
+    if ( SUCCEEDED( QueryApiImpl( &CLSID_XThreadingImpl, IID_IXThreadingImpl, (void **)&xthreading ) ) )
+    {
+        xthreading->XAsyncComplete( ctx->async, hr, SUCCEEDED(hr) ? ctx->resultSize : 0 );
+        xthreading->Release();
+    }
+    return 0;
+}
+
+static HRESULT WINAPI SaveAsyncProvider( XAsyncOp op, const XAsyncProviderData *data )
+{
+    SaveAsyncContext *ctx = (SaveAsyncContext *)data->context;
+
+    switch (op)
+    {
+        case XAsyncOp::Begin:
+        {
+            ctx->async = data->async;
+            HANDLE thread = CreateThread( nullptr, 0, SaveAsyncThread, ctx, 0, nullptr );
+            if ( !thread ) return HRESULT_FROM_WIN32( GetLastError() );
+            CloseHandle( thread );
+            return S_OK;
+        }
+        case XAsyncOp::GetResult:
+            if ( ctx->fill ) ctx->fill( data->buffer );
+            return S_OK;
+        case XAsyncOp::Cleanup:
+            delete ctx;
+            return S_OK;
+        default:
+            return S_OK;
+    }
+}
+
+static HRESULT BeginSaveAsync( XAsyncBlock *async, const void *identity, const char *name, SaveAsyncContext *ctx )
+{
+    IXThreadingImpl *xthreading;
+    HRESULT hr;
+
+    if ( !async ) { delete ctx; return E_POINTER; }
+    if ( FAILED( hr = QueryApiImpl( &CLSID_XThreadingImpl, IID_IXThreadingImpl, (void **)&xthreading ) ) ) { delete ctx; return hr; }
+    hr = xthreading->XAsyncBegin( async, ctx, identity, name, SaveAsyncProvider );
+    xthreading->Release();
+    if ( FAILED( hr ) ) delete ctx;
+    return hr;
+}
+
+static HRESULT GetSaveAsyncResult( XAsyncBlock *async, const void *identity, SIZE_T size, void *buffer, SIZE_T *used )
+{
+    IXThreadingImpl *xthreading;
+    HRESULT hr;
+
+    if ( FAILED( hr = QueryApiImpl( &CLSID_XThreadingImpl, IID_IXThreadingImpl, (void **)&xthreading ) ) ) return hr;
+    hr = xthreading->XAsyncGetResult( async, identity, size, buffer, used );
+    xthreading->Release();
+    return hr;
+}
+
+static const char InitProviderIdentity[] = "XGameSaveInitializeProviderAsync";
+static const char QuotaIdentity[] = "XGameSaveGetRemainingQuotaAsync";
+static const char DeleteIdentity[] = "XGameSaveDeleteContainerAsync";
+static const char ReadIdentity[] = "XGameSaveReadBlobDataAsync";
+static const char SubmitIdentity[] = "XGameSaveSubmitUpdateAsync";
+static const char FilesFolderIdentity[] = "XGameSaveFilesGetFolderWithUiAsync";
+
+class XGameSaveImpl :
+    public IXGameSaveImpl3
+{
+public:
+    HRESULT WINAPI QueryInterface( REFIID iid, void **out )
+    {
+        TRACE( "iface %p, iid %s, out %p.\n", this, debugstr_guid( &iid ), out );
+
+        if (!out) return E_POINTER;
+        *out = nullptr;
+
+        if ( iid == __uuidof( IUnknown ) ||
+             iid == __uuidof( IXGameSaveImpl ) ||
+             iid == __uuidof( IXGameSaveImpl2 ) ||
+             iid == __uuidof( IXGameSaveImpl3 ) )
+        {
+            AddRef();
+            *out = static_cast<IXGameSaveImpl3 *>(this);
+            return S_OK;
+        }
+
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( &iid ) );
+        return E_NOINTERFACE;
+    }
+
+    ULONG WINAPI AddRef() noexcept override { return static_cast<ULONG>(++ref); }
+    ULONG WINAPI Release() noexcept override { return static_cast<ULONG>(--ref); }
+
+    HRESULT WINAPI XGameSaveInitializeProvider( XUserHandle requestingUser, const char *configurationId, BOOLEAN syncOnDemand, XGameSaveProviderHandle *provider ) override
+    {
+        TRACE( "requestingUser %p, configurationId %s, syncOnDemand %d, provider %p\n", requestingUser, debugstr_a( configurationId ), syncOnDemand, provider );
+
+        if ( !provider ) return E_POINTER;
+        std::string root = TitleDir( "GameSave" );
+        if ( root.empty() ) return E_FAIL;
+        *provider = new XGameSaveProvider{ root };
+        return S_OK;
+    }
+
+    HRESULT WINAPI XGameSaveInitializeProviderAsync( XUserHandle requestingUser, const char *configurationId, BOOLEAN syncOnDemand, XAsyncBlock *async ) override
+    {
+        TRACE( "requestingUser %p, configurationId %s, syncOnDemand %d, async %p\n", requestingUser, debugstr_a( configurationId ), syncOnDemand, async );
+
+        auto ctx = new SaveAsyncContext();
+        auto handle = std::make_shared<XGameSaveProviderHandle>( nullptr );
+        ctx->work = [this, requestingUser, handle]( SaveAsyncContext *c ) {
+            c->resultSize = sizeof(XGameSaveProviderHandle);
+            return XGameSaveInitializeProvider( requestingUser, nullptr, FALSE, handle.get() );
+        };
+        ctx->fill = [handle]( void *buffer ) { memcpy( buffer, handle.get(), sizeof(XGameSaveProviderHandle) ); };
+        return BeginSaveAsync( async, InitProviderIdentity, "XGameSaveInitializeProviderAsync", ctx );
+    }
+
+    HRESULT WINAPI XGameSaveInitializeProviderResult( XAsyncBlock *async, XGameSaveProviderHandle *provider ) override
+    {
+        TRACE( "async %p, provider %p\n", async, provider );
+        if ( !provider ) return E_POINTER;
+        return GetSaveAsyncResult( async, InitProviderIdentity, sizeof(*provider), provider, nullptr );
+    }
+
+    void WINAPI XGameSaveCloseProvider( XGameSaveProviderHandle provider ) override
+    {
+        TRACE( "provider %p\n", provider );
+        delete provider;
+    }
+
+    HRESULT WINAPI XGameSaveGetRemainingQuota( XGameSaveProviderHandle provider, INT64 *remainingQuota ) override
+    {
+        TRACE( "provider %p, remainingQuota %p\n", provider, remainingQuota );
+        if ( !provider ) return E_GS_HANDLE_EXPIRED;
+        if ( !remainingQuota ) return E_POINTER;
+        *remainingQuota = GameSaveQuotaBytes - UsedBytes( provider );
+        return S_OK;
+    }
+
+    HRESULT WINAPI XGameSaveGetRemainingQuotaAsync( XGameSaveProviderHandle provider, XAsyncBlock *async ) override
+    {
+        TRACE( "provider %p, async %p\n", provider, async );
+
+        auto ctx = new SaveAsyncContext();
+        auto quota = std::make_shared<INT64>( 0 );
+        ctx->work = [this, provider, quota]( SaveAsyncContext *c ) {
+            c->resultSize = sizeof(INT64);
+            return XGameSaveGetRemainingQuota( provider, quota.get() );
+        };
+        ctx->fill = [quota]( void *buffer ) { memcpy( buffer, quota.get(), sizeof(INT64) ); };
+        return BeginSaveAsync( async, QuotaIdentity, "XGameSaveGetRemainingQuotaAsync", ctx );
+    }
+
+    HRESULT WINAPI XGameSaveGetRemainingQuotaResult( XAsyncBlock *async, INT64 *remainingQuota ) override
+    {
+        TRACE( "async %p, remainingQuota %p\n", async, remainingQuota );
+        if ( !remainingQuota ) return E_POINTER;
+        return GetSaveAsyncResult( async, QuotaIdentity, sizeof(*remainingQuota), remainingQuota, nullptr );
+    }
+
+    HRESULT WINAPI XGameSaveDeleteContainer( XGameSaveProviderHandle provider, const char *containerName ) override
+    {
+        TRACE( "provider %p, containerName %s\n", provider, debugstr_a( containerName ) );
+
+        if ( !provider ) return E_GS_HANDLE_EXPIRED;
+        if ( !containerName || !*containerName ) return E_GS_INVALID_CONTAINER_NAME;
+
+        XGameSaveContainer c{ provider, containerName };
+        std::string dir = ContainerDir( &c );
+        for ( auto &b : ListBlobs( dir, nullptr ) ) DeleteFileA( (dir + EncodeName( b.first.c_str() )).c_str() );
+        DeleteFileA( (dir + DisplayNameFile).c_str() );
+        RemoveDirectoryA( dir.c_str() );
+        return S_OK;
+    }
+
+    HRESULT WINAPI XGameSaveDeleteContainerAsync( XGameSaveProviderHandle provider, const char *containerName, XAsyncBlock *async ) override
+    {
+        TRACE( "provider %p, containerName %s, async %p\n", provider, debugstr_a( containerName ), async );
+
+        auto ctx = new SaveAsyncContext();
+        std::string name = containerName ? containerName : "";
+        ctx->work = [this, provider, name]( SaveAsyncContext * ) { return XGameSaveDeleteContainer( provider, name.c_str() ); };
+        return BeginSaveAsync( async, DeleteIdentity, "XGameSaveDeleteContainerAsync", ctx );
+    }
+
+    HRESULT WINAPI XGameSaveDeleteContainerResult( XAsyncBlock *async ) override
+    {
+        TRACE( "async %p\n", async );
+        return GetSaveAsyncResult( async, DeleteIdentity, 0, nullptr, nullptr );
+    }
+
+    HRESULT WINAPI XGameSaveGetContainerInfo( XGameSaveProviderHandle provider, const char *containerName, void *context, XGameSaveContainerInfoCallback *callback ) override
+    {
+        BOOLEAN keepGoing;
+
+        TRACE( "provider %p, containerName %s, context %p, callback %p\n", provider, debugstr_a( containerName ), context, callback );
+
+        if ( !provider ) return E_GS_HANDLE_EXPIRED;
+        if ( !containerName || !callback ) return E_INVALIDARG;
+        std::string encoded = EncodeName( containerName );
+        if ( !ContainerExists( provider->root + encoded ) ) return S_OK;  // no callback for missing containers
+        return ReportContainer( provider, encoded, context, callback, &keepGoing );
+    }
+
+    HRESULT WINAPI XGameSaveEnumerateContainerInfo( XGameSaveProviderHandle provider, void *context, XGameSaveContainerInfoCallback *callback ) override
+    {
+        return XGameSaveEnumerateContainerInfoByName( provider, nullptr, context, callback );
+    }
+
+    HRESULT WINAPI XGameSaveEnumerateContainerInfoByName( XGameSaveProviderHandle provider, const char *containerNamePrefix, void *context, XGameSaveContainerInfoCallback *callback ) override
+    {
+        WIN32_FIND_DATAA fd;
+        BOOLEAN keepGoing = TRUE;
+        size_t prefixLen = containerNamePrefix ? strlen( containerNamePrefix ) : 0;
+
+        TRACE( "provider %p, containerNamePrefix %s, context %p, callback %p\n", provider, debugstr_a( containerNamePrefix ), context, callback );
+
+        if ( !provider ) return E_GS_HANDLE_EXPIRED;
+        if ( !callback ) return E_INVALIDARG;
+
+        HANDLE find = FindFirstFileA( (provider->root + "*").c_str(), &fd );
+        if ( find == INVALID_HANDLE_VALUE ) return S_OK;
+        do
+        {
+            if ( !(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || fd.cFileName[0] == '.' ) continue;
+            if ( prefixLen && DecodeName( fd.cFileName ).compare( 0, prefixLen, containerNamePrefix ) != 0 ) continue;
+            ReportContainer( provider, fd.cFileName, context, callback, &keepGoing );
+        } while ( keepGoing && FindNextFileA( find, &fd ) );
+        FindClose( find );
+        return S_OK;
+    }
+
+    HRESULT WINAPI XGameSaveCreateContainer( XGameSaveProviderHandle provider, const char *containerName, XGameSaveContainerHandle *containerContext ) override
+    {
+        TRACE( "provider %p, containerName %s, containerContext %p\n", provider, debugstr_a( containerName ), containerContext );
+
+        if ( !provider ) return E_GS_HANDLE_EXPIRED;
+        if ( !containerName || !*containerName || strlen( containerName ) > 255 ) return E_GS_INVALID_CONTAINER_NAME;
+        if ( !containerContext ) return E_POINTER;
+        *containerContext = new XGameSaveContainer{ provider, containerName };
+        return S_OK;
+    }
+
+    void WINAPI XGameSaveCloseContainer( XGameSaveContainerHandle context ) override
+    {
+        TRACE( "context %p\n", context );
+        delete context;
+    }
+
+    HRESULT WINAPI XGameSaveEnumerateBlobInfo( XGameSaveContainerHandle container, void *context, XGameSaveBlobInfoCallback *callback ) override
+    {
+        return XGameSaveEnumerateBlobInfoByName( container, nullptr, context, callback );
+    }
+
+    HRESULT WINAPI XGameSaveEnumerateBlobInfoByName( XGameSaveContainerHandle container, const char *blobNamePrefix, void *context, XGameSaveBlobInfoCallback *callback ) override
+    {
+        size_t prefixLen = blobNamePrefix ? strlen( blobNamePrefix ) : 0;
+
+        TRACE( "container %p, blobNamePrefix %s, context %p, callback %p\n", container, debugstr_a( blobNamePrefix ), context, callback );
+
+        if ( !container ) return E_GS_HANDLE_EXPIRED;
+        if ( !callback ) return E_INVALIDARG;
+        for ( auto &b : ListBlobs( ContainerDir( container ), nullptr ) )
+        {
+            if ( prefixLen && b.first.compare( 0, prefixLen, blobNamePrefix ) != 0 ) continue;
+            XGameSaveBlobInfo info{ b.first.c_str(), (UINT32)b.second };
+            if ( !callback( &info, context ) ) break;
+        }
+        return S_OK;
+    }
+
+    HRESULT WINAPI XGameSaveReadBlobData( XGameSaveContainerHandle container, const char **blobNames, UINT32 *countOfBlobs, SIZE_T blobsSize, XGameSaveBlob *blobData ) override
+    {
+        std::vector<std::pair<std::string, std::vector<UINT8>>> blobs;
+        HRESULT hr;
+
+        TRACE( "container %p, blobNames %p, countOfBlobs %p, blobsSize %Iu, blobData %p\n", container, blobNames, countOfBlobs, blobsSize, blobData );
+
+        if ( !container ) return E_GS_HANDLE_EXPIRED;
+        if ( !countOfBlobs || !blobData ) return E_POINTER;
+        if ( FAILED( hr = LoadBlobs( container, blobNames, *countOfBlobs, blobs ) ) ) return hr;
+        if ( blobsSize < PackedSize( blobs ) ) return E_GS_PROVIDED_BUFFER_TOO_SMALL;
+        PackBlobs( blobs, blobData );
+        *countOfBlobs = (UINT32)blobs.size();
+        return S_OK;
+    }
+
+    HRESULT WINAPI XGameSaveReadBlobDataAsync( XGameSaveContainerHandle container, const char **blobNames, UINT32 countOfBlobs, XAsyncBlock *async ) override
+    {
+        TRACE( "container %p, blobNames %p, countOfBlobs %u, async %p\n", container, blobNames, countOfBlobs, async );
+
+        if ( !container ) return E_GS_HANDLE_EXPIRED;
+        // copy the names now: the caller's array only has to live until this call returns
+        std::vector<std::string> names;
+        bool all = !blobNames;
+        for ( UINT32 i = 0; !all && i < countOfBlobs; i++ ) names.emplace_back( blobNames[i] );
+
+        auto ctx = new SaveAsyncContext();
+        auto blobs = std::make_shared<std::vector<std::pair<std::string, std::vector<UINT8>>>>();
+        ctx->work = [container, names, all, blobs]( SaveAsyncContext *c ) {
+            std::vector<const char *> ptrs;
+            for ( auto &n : names ) ptrs.push_back( n.c_str() );
+            HRESULT hr = LoadBlobs( container, all ? nullptr : ptrs.data(), (UINT32)ptrs.size(), *blobs );
+            c->resultSize = PackedSize( *blobs );
+            return hr;
+        };
+        ctx->fill = [blobs]( void *buffer ) { PackBlobs( *blobs, buffer ); };
+        return BeginSaveAsync( async, ReadIdentity, "XGameSaveReadBlobDataAsync", ctx );
+    }
+
+    HRESULT WINAPI XGameSaveReadBlobDataResult( XAsyncBlock *async, SIZE_T blobsSize, XGameSaveBlob *blobData, UINT32 *countOfBlobs ) override
+    {
+        SIZE_T used = 0;
+        HRESULT hr;
+
+        TRACE( "async %p, blobsSize %Iu, blobData %p, countOfBlobs %p\n", async, blobsSize, blobData, countOfBlobs );
+
+        if ( !blobData || !countOfBlobs ) return E_POINTER;
+        if ( FAILED( hr = GetSaveAsyncResult( async, ReadIdentity, blobsSize, blobData, &used ) ) ) return hr;
+        // names follow the XGameSaveBlob array, so the first name marks where the array ends
+        *countOfBlobs = used ? (UINT32)(((char *)blobData[0].info.name - (char *)blobData) / sizeof(XGameSaveBlob)) : 0;
+        return S_OK;
+    }
+
+    HRESULT WINAPI XGameSaveCreateUpdate( XGameSaveContainerHandle container, const char *containerDisplayName, XGameSaveUpdateHandle *updateContext ) override
+    {
+        TRACE( "container %p, containerDisplayName %s, updateContext %p\n", container, debugstr_a( containerDisplayName ), updateContext );
+
+        if ( !container ) return E_GS_HANDLE_EXPIRED;
+        if ( !updateContext ) return E_POINTER;
+        auto u = new XGameSaveUpdate();
+        u->container = container;
+        if ( containerDisplayName ) u->displayName = containerDisplayName;
+        *updateContext = u;
+        return S_OK;
+    }
+
+    void WINAPI XGameSaveCloseUpdate( XGameSaveUpdateHandle context ) override
+    {
+        TRACE( "context %p\n", context );
+        delete context;
+    }
+
+    HRESULT WINAPI XGameSaveSubmitBlobWrite( XGameSaveUpdateHandle updateContext, const char *blobName, UINT8 *data, SIZE_T byteCount ) override
+    {
+        TRACE( "updateContext %p, blobName %s, data %p, byteCount %Iu\n", updateContext, debugstr_a( blobName ), data, byteCount );
+
+        if ( !updateContext ) return E_GS_HANDLE_EXPIRED;
+        if ( !blobName || (!data && byteCount) ) return E_INVALIDARG;
+        updateContext->writes.emplace_back( blobName, std::vector<UINT8>( data, data + byteCount ) );
+        return S_OK;
+    }
+
+    HRESULT WINAPI XGameSaveSubmitBlobDelete( XGameSaveUpdateHandle updateContext, const char *blobName ) override
+    {
+        TRACE( "updateContext %p, blobName %s\n", updateContext, debugstr_a( blobName ) );
+
+        if ( !updateContext ) return E_GS_HANDLE_EXPIRED;
+        if ( !blobName ) return E_INVALIDARG;
+        updateContext->deletes.emplace_back( blobName );
+        return S_OK;
+    }
+
+    HRESULT WINAPI XGameSaveSubmitUpdate( XGameSaveUpdateHandle updateContext ) override
+    {
+        TRACE( "updateContext %p\n", updateContext );
+        if ( !updateContext ) return E_GS_HANDLE_EXPIRED;
+        return ApplyUpdate( updateContext );
+    }
+
+    HRESULT WINAPI XGameSaveSubmitUpdateAsync( XGameSaveUpdateHandle updateContext, XAsyncBlock *async ) override
+    {
+        TRACE( "updateContext %p, async %p\n", updateContext, async );
+
+        if ( !updateContext ) return E_GS_HANDLE_EXPIRED;
+        // snapshot the update: the game may close the handle before the work runs
+        auto snapshot = std::make_shared<XGameSaveUpdate>( *updateContext );
+        auto container = std::make_shared<XGameSaveContainer>( *updateContext->container );
+        snapshot->container = container.get();
+
+        auto ctx = new SaveAsyncContext();
+        ctx->work = [snapshot, container]( SaveAsyncContext * ) { return ApplyUpdate( snapshot.get() ); };
+        return BeginSaveAsync( async, SubmitIdentity, "XGameSaveSubmitUpdateAsync", ctx );
+    }
+
+    HRESULT WINAPI XGameSaveSubmitUpdateResult( XAsyncBlock *async ) override
+    {
+        TRACE( "async %p\n", async );
+        return GetSaveAsyncResult( async, SubmitIdentity, 0, nullptr, nullptr );
+    }
+
+    HRESULT WINAPI XGameSaveFilesGetFolderWithUiAsync( XUserHandle requestingUser, const char *configurationId, XAsyncBlock *async ) override
+    {
+        TRACE( "requestingUser %p, configurationId %s, async %p\n", requestingUser, debugstr_a( configurationId ), async );
+
+        auto ctx = new SaveAsyncContext();
+        auto folder = std::make_shared<std::string>();
+        ctx->work = [folder]( SaveAsyncContext *c ) {
+            *folder = TitleDir( "GameSaveFiles" );
+            c->resultSize = folder->size() + 1;
+            return folder->empty() ? E_FAIL : S_OK;
+        };
+        ctx->fill = [folder]( void *buffer ) { memcpy( buffer, folder->c_str(), folder->size() + 1 ); };
+        return BeginSaveAsync( async, FilesFolderIdentity, "XGameSaveFilesGetFolderWithUiAsync", ctx );
+    }
+
+    HRESULT WINAPI XGameSaveFilesGetFolderWithUiResult( XAsyncBlock *async, SIZE_T folderSize, char *folderResult ) override
+    {
+        TRACE( "async %p, folderSize %Iu, folderResult %p\n", async, folderSize, folderResult );
+        if ( !folderResult ) return E_POINTER;
+        return GetSaveAsyncResult( async, FilesFolderIdentity, folderSize, folderResult, nullptr );
+    }
