+static std::string Utf8FromHString( HSTRING str )
+{
+    UINT32 len = 0;
+    LPCWSTR buf = WindowsGetStringRawBuffer( str, &len );
+    int size;
+    std::string out;
+
+    if ( !len ) return out;
+    size = WideCharToMultiByte( CP_UTF8, 0, buf, len, nullptr, 0, nullptr, nullptr );
+    if ( size <= 0 ) return out;
+    out.resize( size );
+    WideCharToMultiByte( CP_UTF8, 0, buf, len, &out[0], size, nullptr, nullptr );
+    return out;
+}
 
