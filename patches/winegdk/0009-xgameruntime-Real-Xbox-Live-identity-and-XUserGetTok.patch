+static std::string Utf8FromWide( const WCHAR *str )
 {
-    return user == &g_offline_user;
+    int size;
+    std::string out;
+
+    if ( !str || !*str ) return out;
+    size = WideCharToMultiByte( CP_UTF8, 0, str, -1, nullptr, 0, nullptr, nullptr );
+    if ( size <= 1 ) return out;
+    out.resize( size );
+    WideCharToMultiByte( CP_UTF8, 0, str, -1, &out[0], size, nullptr, nullptr );
+    out.resize( size - 1 ); /* drop the terminator */
+    return out;
