+/*
+ * Async helper (same pattern as XGameSave.cpp): work runs on its own thread and completes the
+ * XAsyncBlock afterwards; the result is packed into the caller's buffer from XAsyncOp::GetResult.
+ */
+struct AsyncJob
+{
+    std::function<HRESULT(AsyncJob *)> work;   /* worker thread; on success sets resultSize */
+    std::function<void(void *buffer)> fill;    /* caller's thread, inside GetResult */
+    SIZE_T resultSize = 0;
+    XAsyncBlock *async = nullptr;              /* engine-side block from Begin */
+    std::atomic<bool> cancelled{ false };
+};
+
+static DWORD WINAPI AsyncJobThread( void *param )
+{
+    AsyncJob *job = (AsyncJob *)param;
+    IXThreadingImpl *xthreading;
+    HRESULT hr = job->work( job );
+    XAsyncBlock *async = job->async;
+    SIZE_T size;
+
+    if ( SUCCEEDED( hr ) && job->cancelled ) hr = E_ABORT;
+    size = SUCCEEDED( hr ) ? job->resultSize : 0;
+
+    if ( SUCCEEDED( QueryApiImpl( &CLSID_XThreadingImpl, IID_IXThreadingImpl, (void **)&xthreading ) ) )
+    {
+        xthreading->XAsyncComplete( async, hr, size ); /* may run Cleanup and delete job */
+        xthreading->Release();
+    }
+    return 0;
+}
+
+static HRESULT WINAPI AsyncJobProvider( XAsyncOp op, const XAsyncProviderData *data )
+{
+    AsyncJob *job = (AsyncJob *)data->context;
+
+    switch (op)
+    {
+        case XAsyncOp::Begin:
+        {
+            job->async = data->async;
+            HANDLE thread = CreateThread( nullptr, 0, AsyncJobThread, job, 0, nullptr );
+            if ( !thread ) return HRESULT_FROM_WIN32( GetLastError() );
+            CloseHandle( thread );
+            return S_OK;
+        }
+        case XAsyncOp::GetResult:
+            if ( job->fill ) job->fill( data->buffer );
+            return S_OK;
+        case XAsyncOp::Cancel:
+            /* best effort: the worker completes with E_ABORT once the request returns */
+            job->cancelled = true;
+            return S_OK;
+        case XAsyncOp::Cleanup:
+            delete job;
+            return S_OK;
+        default:
+            return S_OK;
+    }
+}
+
+static HRESULT BeginAsyncJob( XAsyncBlock *async, const void *identity, const char *name, AsyncJob *job )
+{
+    IXThreadingImpl *xthreading;
+    HRESULT hr;
+
+    if ( !async ) { delete job; return E_POINTER; }
+    if ( FAILED( hr = QueryApiImpl( &CLSID_XThreadingImpl, IID_IXThreadingImpl, (void **)&xthreading ) ) ) { delete job; return hr; }
+    hr = xthreading->XAsyncBegin( async, job, identity, name, AsyncJobProvider );
+    xthreading->Release();
+    if ( FAILED( hr ) ) delete job; /* only then did the provider never see the job */
+    return hr;
+}
+
+static HRESULT GetAsyncJobResultSize( XAsyncBlock *async, SIZE_T *size )
+{
+    IXThreadingImpl *xthreading;
+    HRESULT hr;
+
+    if ( !async || !size ) return E_POINTER;
+    if ( FAILED( hr = QueryApiImpl( &CLSID_XThreadingImpl, IID_IXThreadingImpl, (void **)&xthreading ) ) ) return hr;
+    hr = xthreading->XAsyncGetResultSize( async, size );
+    xthreading->Release();
+    return hr;
+}
+
+static HRESULT GetAsyncJobResult( XAsyncBlock *async, const void *identity, SIZE_T size, void *buffer, SIZE_T *used )
+{
+    IXThreadingImpl *xthreading;
+    HRESULT hr;
+
+    if ( !async ) return E_POINTER;
+    if ( FAILED( hr = QueryApiImpl( &CLSID_XThreadingImpl, IID_IXThreadingImpl, (void **)&xthreading ) ) ) return hr;
+    hr = xthreading->XAsyncGetResult( async, identity, size, buffer, used );
+    xthreading->Release();
+    return hr;
+}
+
+/*
+ * XUserGetTokenAndSignature*: the game's HTTP request is forwarded to xodus-service, which
+ * answers with the XSTS Authorization value and the request signature.
+ */
+struct TokenRequest
+{
+    bool forceRefresh = false;
+    std::string method;
+    std::string url;
+    std::vector<std::string> headerNames;
+    std::vector<std::string> headerValues;
+    std::vector<BYTE> body;
+};
+
+struct TokenResult
+{
+    std::string token;                 /* "XBL3.0 x=<uhs>;<xsts>" */
+    std::string signature;             /* base64, empty when the endpoint is not signed */
+    std::vector<WCHAR> tokenW;         /* UTF-16 variants, NUL terminated */
+    std::vector<WCHAR> signatureW;
+};
+
+/*
+ * Transport problems map to E_GAMEUSER_FAILED_TO_GET_TOKEN; an <Error> from the service is
+ * returned verbatim (E_GAMEUSER_SIGNED_OUT, E_GAMEUSER_RESOLVE_USER_ISSUE_REQUIRED, E_FAIL, ...).
+ * Token and signature values are never traced, only their sizes.
+ */
+static HRESULT RequestTokenAndSignature( const TokenRequest &req, TokenResult &out )
+{
+    std::vector<LPCSTR> names, values;
+    HRESULT hr, error = S_OK;
+    DWORD wait;
+    HSTRING token = nullptr, signature = nullptr, message = nullptr;
+
+    IAsyncOperation<ITokenAndSignatureResponse *> *operation = nullptr;
+    ITokenAndSignatureResponse *response = nullptr;
+
+    if ( FAILED( hr = XodusEnsureService() ) )
+    {
+        TRACE( "xodus service unavailable (%#lx)\n", hr );
+        return E_GAMEUSER_FAILED_TO_GET_TOKEN;
+    }
+
+    for ( auto &n : req.headerNames ) names.push_back( n.c_str() );
+    for ( auto &v : req.headerValues ) values.push_back( v.c_str() );
+
+    hr = xodus_service->TokenAndSignatureRequest( msaAppId ? msaAppId : "", titleId, req.method.c_str(), req.url.c_str(),
+                                                  static_cast<UINT32>(names.size()), names.data(), values.data(),
+                                                  static_cast<UINT32>(req.body.size()), req.body.data(), req.forceRefresh,
+                                                  IPC_TOKEN_TIMEOUT_MS, &operation );
+    if ( FAILED( hr ) )
+    {
+        WARN( "TokenAndSignatureRequest could not be dispatched (%#lx)\n", hr );
+        return E_GAMEUSER_FAILED_TO_GET_TOKEN;
+    }
+
+    wait = AsyncOperationCompletedHandler<ITokenAndSignatureResponse *>::await_AsyncOperation( operation, INFINITE ); /* bounded by IPC_TOKEN_TIMEOUT_MS */
+    hr = wait == WAIT_OBJECT_0 ? operation->GetResults( &response ) : E_FAIL;
+    operation->Release();
+    if ( FAILED( hr ) || !response )
+    {
+        WARN( "token request failed (%#lx)\n", hr );
+        return E_GAMEUSER_FAILED_TO_GET_TOKEN;
+    }
+
+    response->get_Error( &error );
+    if ( FAILED( error ) )
+    {
+        response->get_Message( &message );
+        WARN( "xodus service refused the token request: %#lx (%s)\n", error, debugstr_hstring( message ) );
+        WindowsDeleteString( message );
+        response->Release();
+        return error;
+    }
+
+    response->get_Token( &token );
+    response->get_Signature( &signature );
+    out.token = Utf8FromHString( token );
+    out.signature = Utf8FromHString( signature );
+    WindowsDeleteString( token );
+    WindowsDeleteString( signature );
+    response->Release();
+
+    if ( out.token.empty() )
+    {
+        WARN( "the xodus service returned an empty token\n" );
+        return E_GAMEUSER_FAILED_TO_GET_TOKEN;
+    }
+
+    TRACE( "got a token of %Iu bytes and a signature of %Iu bytes\n", out.token.size(), out.signature.size() );
+    return S_OK;
+}
+
+/*
+ * Result layout handed to the game (XUserGetTokenAndSignatureData, then the strings, pointers into
+ * the same buffer): sizes/counts include the terminator, an unsigned request has signature NULL/0.
+ */
+static SIZE_T PackedTokenSize( const TokenResult &r )
+{
+    return sizeof(XUserGetTokenAndSignatureData) + r.token.size() + 1 + ( r.signature.empty() ? 0 : r.signature.size() + 1 );
+}
+
+static void PackToken( const TokenResult &r, void *buffer )
+{
+    XUserGetTokenAndSignatureData *data = (XUserGetTokenAndSignatureData *)buffer;
+    char *cursor = (char *)( data + 1 );
+
+    memcpy( cursor, r.token.c_str(), r.token.size() + 1 );
+    data->token = cursor;
+    data->tokenSize = r.token.size() + 1;
+    cursor += data->tokenSize;
+
+    if ( r.signature.empty() )
+    {
+        data->signature = nullptr;
+        data->signatureSize = 0;
+    }
+    else
+    {
+        memcpy( cursor, r.signature.c_str(), r.signature.size() + 1 );
+        data->signature = cursor;
+        data->signatureSize = r.signature.size() + 1;
+    }
+}
+
+static SIZE_T PackedTokenSizeW( const TokenResult &r )
+{
+    return sizeof(XUserGetTokenAndSignatureUtf16Data) + ( r.tokenW.size() + ( r.signature.empty() ? 0 : r.signatureW.size() ) ) * sizeof(WCHAR);
+}
+
+static void PackTokenW( const TokenResult &r, void *buffer )
+{
+    XUserGetTokenAndSignatureUtf16Data *data = (XUserGetTokenAndSignatureUtf16Data *)buffer;
+    WCHAR *cursor = (WCHAR *)( data + 1 );
+
+    memcpy( cursor, r.tokenW.data(), r.tokenW.size() * sizeof(WCHAR) );
+    data->token = cursor;
+    data->tokenCount = r.tokenW.size();
+    cursor += r.tokenW.size();
+
+    if ( r.signature.empty() )
+    {
+        data->signature = nullptr;
+        data->signatureCount = 0;
+    }
+    else
+    {
+        memcpy( cursor, r.signatureW.data(), r.signatureW.size() * sizeof(WCHAR) );
+        data->signature = cursor;
+        data->signatureCount = r.signatureW.size();
+    }
+}
+
+/* Everything one token request needs, shared between the worker and the GetResult packer. */
+struct TokenJobState
+{
+    TokenRequest request;
+    TokenResult result;
+    bool utf16 = false;
+};
+
+static HRESULT BeginTokenRequest( XUserHandle user, XUserGetTokenAndSignatureOptions options, std::unique_ptr<TokenRequest> req, bool utf16, XAsyncBlock *async )
+{
+    const UINT32 opts = static_cast<UINT32>(options);
+    const UINT32 known = static_cast<UINT32>(XUserGetTokenAndSignatureOptions::ForceRefresh) | static_cast<UINT32>(XUserGetTokenAndSignatureOptions::AllUsers);
+
+    if ( !async ) return E_POINTER;
+    if ( !IsLocalUser( user ) ) return E_INVALIDARG;
+    if ( opts & ~known ) FIXME( "unknown options %#x ignored\n", opts & ~known );
+
+    if ( !HaveRealUser() )
+    {
+        /* offline (no service, XODUS_OFFLINE, or nobody signed in): keep the historical E_NOTIMPL */
+        TRACE( "no signed-in Xbox Live user, returning E_NOTIMPL\n" );
+        return E_NOTIMPL;
+    }
+
+    auto state = std::make_shared<TokenJobState>();
+    AsyncJob *job = new AsyncJob();
+
+    state->request = std::move( *req );
+    state->request.forceRefresh = opts & static_cast<UINT32>(XUserGetTokenAndSignatureOptions::ForceRefresh);
+    state->utf16 = utf16;
+
+    job->work = [state]( AsyncJob *j ) -> HRESULT {
+        HRESULT hr = RequestTokenAndSignature( state->request, state->result );
+        if ( SUCCEEDED( hr ) )
+        {
+            if ( state->utf16 )
+            {
+                state->result.tokenW = WideFromUtf8( state->result.token );
+                state->result.signatureW = WideFromUtf8( state->result.signature );
+            }
+            j->resultSize = state->utf16 ? PackedTokenSizeW( state->result ) : PackedTokenSize( state->result );
+        }
+        return hr;
+    };
+    job->fill = [state]( void *buffer ) {
+        if ( state->utf16 ) PackTokenW( state->result, buffer );
+        else PackToken( state->result, buffer );
