+/*
+ * Asks xodus-service who is signed in and makes that account the local user. Runs on the
+ * XUserAddAsync worker thread, so the game is never blocked on its own thread; a service that is
+ * absent, offline (XODUS_OFFLINE=1), signed out, slow or answering with an error keeps the offline
+ * identity. Retried on later XUserAddAsync calls until a signed-in user was seen.
+ */
+static void AcquireUserIdentity()
+{
+    HRESULT hr, error = S_OK;
+    DWORD wait;
+    boolean signedIn = false;
+    UINT64 xuid = 0;
+    UINT32 ageGroup = 0;
+    HSTRING gamertag = nullptr, modern = nullptr, suffix = nullptr, unique = nullptr;
+    UserIdentity id;
+
+    IAsyncOperation<IUserInfoResponse *> *operation = nullptr;
+    IUserInfoResponse *info = nullptr;
+
+    if ( HaveRealUser() ) return;
+
+    if ( FAILED( hr = XodusEnsureService() ) )
+    {
+        TRACE( "xodus service unavailable (%#lx), using the offline user\n", hr );
+        return;
+    }
+
+    hr = xodus_service->UserInfoRequest( msaAppId ? msaAppId : "", titleId, FALSE, IPC_USER_INFO_TIMEOUT_MS, &operation );
+    if ( FAILED( hr ) )
+    {
+        TRACE( "UserInfoRequest could not be dispatched (%#lx), using the offline user\n", hr );
+        return;
+    }
+
+    wait = AsyncOperationCompletedHandler<IUserInfoResponse *>::await_AsyncOperation( operation, INFINITE ); /* bounded by IPC_USER_INFO_TIMEOUT_MS */
+    hr = wait == WAIT_OBJECT_0 ? operation->GetResults( &info ) : E_FAIL;
+    operation->Release();
+    if ( FAILED( hr ) || !info )
+    {
+        TRACE( "UserInfoRequest failed (%#lx), using the offline user\n", hr );
+        return;
+    }
+
+    info->get_Error( &error );
+    info->get_SignedIn( &signedIn );
+    info->get_Xuid( &xuid );
+
+    if ( FAILED( error ) )
+        TRACE( "xodus service reported %#lx, using the offline user\n", error );
+    else if ( !signedIn || !xuid )
+        TRACE( "no Xbox Live user is signed in to xodus, using the offline user\n" );
+    else
+    {
+        info->get_Gamertag( &gamertag );
+        info->get_ModernGamertag( &modern );
+        info->get_ModernGamertagSuffix( &suffix );
+        info->get_UniqueModernGamertag( &unique );
+        info->get_AgeGroup( &ageGroup );
+
+        id.real = true;
+        id.xuid = xuid;
+        id.gamertag = Utf8FromHString( gamertag );
+        id.modernGamertag = Utf8FromHString( modern );
+        id.modernGamertagSuffix = Utf8FromHString( suffix );
+        id.uniqueModernGamertag = Utf8FromHString( unique );
+        if ( id.gamertag.empty() && id.modernGamertag.empty() ) id.gamertag = id.modernGamertag = OfflineGamertag();
+        if ( id.gamertag.empty() ) id.gamertag = id.modernGamertag;
+        if ( id.modernGamertag.empty() ) id.modernGamertag = id.gamertag;
+        if ( id.uniqueModernGamertag.empty() )
+            id.uniqueModernGamertag = id.modernGamertagSuffix.empty() ? id.modernGamertag : id.modernGamertag + "#" + id.modernGamertagSuffix;
+        id.ageGroup = ageGroup <= static_cast<UINT32>(XUserAgeGroup::Adult) ? static_cast<XUserAgeGroup>(ageGroup) : XUserAgeGroup::Unknown;
+
+        {
+            const std::lock_guard<std::mutex> lock( g_identity_lock );
+            g_identity = id;
+            g_identity_initialised = true;
+        }
+        TRACE( "signed in as xuid %I64u, gamertag %s, modern %s#%s, age group %u\n", xuid, debugstr_a( id.gamertag.c_str() ),
+               debugstr_a( id.modernGamertag.c_str() ), debugstr_a( id.modernGamertagSuffix.c_str() ), ageGroup );
+
+        WindowsDeleteString( gamertag );
+        WindowsDeleteString( modern );
+        WindowsDeleteString( suffix );
+        WindowsDeleteString( unique );
+    }
+
+    info->Release();
 }
 
