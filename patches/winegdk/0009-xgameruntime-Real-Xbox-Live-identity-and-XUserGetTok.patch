+
+/* NUL-terminated UTF-16, count includes the terminator */
+static std::vector<WCHAR> WideFromUtf8( const std::string &str )
+{
+    int count = MultiByteToWideChar( CP_UTF8, 0, str.c_str(), -1, nullptr, 0 );
+    std::vector<WCHAR> out( count > 0 ? count : 1, 0 );
+
+    if ( count > 0 ) MultiByteToWideChar( CP_UTF8, 0, str.c_str(), -1, out.data(), count );
+    return out;
+}
