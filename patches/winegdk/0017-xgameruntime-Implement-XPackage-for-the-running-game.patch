From 2e78f8325d02467700d66c6f241c28c116792559 Mon Sep 17 00:00:00 2001
From: evilcomputer12 <martinrobotika@gmail.com>
Date: Sat, 10 Oct 2026 07:53:34 +0200
Subject: [PATCH 17/22] xgameruntime: Implement XPackage for the running game.

XPackageIsPackagedProcess reports TRUE once the config identity is known and
XPackageGetCurrentProcessPackageIdentifier returns gdk_package_identifier
(E_NOT_SUFFICIENT_BUFFER when the buffer is too small). The three
XPackageEnumeratePackages slots share one body: kind Game reports the running
game once (identifier, Identity version, DefaultDisplayName,
PublisherDisplayName, StoreId, 8-digit title id, index 0 of 1), kind Content
reports no DLC. XPackageMountWithUiAsync mounts the game's own identifier at
the install directory, completing from a worker thread through
IXThreadingImpl like the C++ async helpers; other identifiers complete with
E_GAMEPACKAGE_NO_PACKAGE_IDENTIFIER. XPackageGetMountPathSize/GetMountPath/
CloseMountHandle work on that handle, and XPackageGetUserLocale returns
en-US unless XODUS_LOCALE is set.

Space Marine 2 calls XPackageEnumeratePackages3(Content, ThisAndRelated) from
its title screen; that now succeeds with an empty DLC list.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../GDKComponent/Ported/xpackage.c            | 282 ++++++++++++++++--
 1 file changed, 261 insertions(+), 21 deletions(-)

diff --git a/dlls/xgameruntime/GDKComponent/Ported/xpackage.c b/dlls/xgameruntime/GDKComponent/Ported/xpackage.c
index 0830125..05e4d5b 100644
--- a/dlls/xgameruntime/GDKComponent/Ported/xpackage.c
+++ b/dlls/xgameruntime/GDKComponent/Ported/xpackage.c
@@ -22,8 +22,20 @@
 
 #include "../../private.h"
 
+#include <stdio.h>
+
 WINE_DEFAULT_DEBUG_CHANNEL(gdkc);
 
+/*
+ * The only package the runtime knows is the running game: its identifier is the Windows package full name
+ * computed from MicrosoftGame.config (gdk_package_identifier) and its mount point is the install directory.
+ */
+
+struct XPackageMountInstance
+{
+    char *path; /* install directory as a UTF-8 Windows path, no trailing backslash */
+};
+
 struct x_package
 {
     IXPackageImpl3 IXPackageImpl3_iface;
@@ -35,6 +47,102 @@ static inline struct x_package *impl_from_IXPackageImpl3( IXPackageImpl3 *iface
     return CONTAINING_RECORD( iface, struct x_package, IXPackageImpl3_iface );
 }
 
+static XVersion parse_version( const char *text )
+{
+    unsigned int major = 0, minor = 0, build = 0, revision = 0;
+    XVersion version;
+
+    sscanf( text, "%u.%u.%u.%u", &major, &minor, &build, &revision );
+    version.Value = 0;
+    version.major = major;
+    version.minor = minor;
+    version.build = build;
+    version.revision = revision;
+    return version;
+}
+
+static XPackageMountHandle create_mount( void )
+{
+    struct XPackageMountInstance *mount;
+    int len;
+
+    if (!(mount = calloc( 1, sizeof(*mount) ))) return NULL;
+    len = WideCharToMultiByte( CP_UTF8, 0, gdk_install_dir_w, -1, NULL, 0, NULL, NULL );
+    if (len <= 0 || !(mount->path = malloc( len )))
+    {
+        free( mount );
+        return NULL;
+    }
+    WideCharToMultiByte( CP_UTF8, 0, gdk_install_dir_w, -1, mount->path, len, NULL, NULL );
+    return mount;
+}
+
+static void close_mount( XPackageMountHandle mount )
+{
+    if (!mount) return;
+    free( mount->path );
+    free( mount );
+}
+
+/*
+ * XPackageMountWithUiAsync completes from a worker thread, like the C++ async helpers in XUser.cpp and
+ * XGameSave.cpp: completing inside the Begin op would run the game's completion routine before the Async
+ * call returned, and the in-tree XAsyncSchedule path is not used. The identity passed to XAsyncBegin and
+ * XAsyncGetResult must be the same pointer.
+ */
+static const char mount_identity[] = "XPackageMountWithUiAsync";
+
+struct mount_job
+{
+    XAsyncBlock *async;        /* engine-side block, from the Begin op */
+    HRESULT hr;                /* outcome, reported by the worker thread */
+    XPackageMountHandle mount; /* handed to the game in GetResult, freed in Cleanup otherwise */
+};
+
+static DWORD WINAPI mount_job_thread( void *param )
+{
+    struct mount_job *job = param;
+    XAsyncBlock *async = job->async;
+    HRESULT hr = job->hr;
+    SIZE_T size = SUCCEEDED( hr ) ? sizeof(XPackageMountHandle) : 0;
+    IXThreadingImpl *xthreading;
+
+    /* XAsyncComplete may run the Cleanup op and free the job: nothing below may touch it. */
+    if (SUCCEEDED( QueryApiImpl( &CLSID_XThreadingImpl, &IID_IXThreadingImpl, (void **)&xthreading ) ))
+    {
+        IXThreadingImpl_XAsyncComplete( xthreading, async, hr, size );
+        IXThreadingImpl_Release( xthreading );
+    }
+    return 0;
+}
+
+static HRESULT WINAPI mount_job_provider( XAsyncOp op, const XAsyncProviderData *data )
+{
+    struct mount_job *job = data->context;
+    HANDLE thread;
+
+    TRACE( "op %d, data %p.\n", op, data );
+
+    switch (op)
+    {
+    case XAsyncOp_Begin:
+        job->async = data->async;
+        if (!(thread = CreateThread( NULL, 0, mount_job_thread, job, 0, NULL ))) return HRESULT_FROM_WIN32( GetLastError() );
+        CloseHandle( thread );
+        return S_OK;
+    case XAsyncOp_GetResult:
+        *(XPackageMountHandle *)data->buffer = job->mount;
+        job->mount = NULL;
+        return S_OK;
+    case XAsyncOp_Cleanup:
+        close_mount( job->mount );
+        free( job );
+        return S_OK;
+    default:
+        return S_OK;
+    }
+}
+
 static HRESULT WINAPI x_package_QueryInterface( IXPackageImpl3 *iface, REFIID iid, void **out )
 {
     struct x_package *impl = impl_from_IXPackageImpl3( iface );
@@ -73,14 +181,31 @@ static ULONG WINAPI x_package_Release( IXPackageImpl3 *iface )
 
 static HRESULT WINAPI x_package_XPackageGetCurrentProcessPackageIdentifier( IXPackageImpl3 *iface, SIZE_T bufferSize, char *buffer )
 {
-    FIXME( "iface %p, bufferSize %Iu, buffer %p stub!\n", iface, bufferSize, buffer );
-    return E_NOTIMPL;
+    SIZE_T needed;
+
+    TRACE( "iface %p, bufferSize %Iu, buffer %p.\n", iface, bufferSize, buffer );
+
+    if (!buffer) return E_POINTER;
+    if (!*gdk_package_identifier) return E_GAMEPACKAGE_APP_NOT_PACKAGED;
+
+    needed = strlen( gdk_package_identifier ) + 1;
+    if (bufferSize < needed)
+    {
+        WARN( "buffer of %Iu bytes is too small for %s (%Iu bytes).\n", bufferSize, debugstr_a( gdk_package_identifier ), needed );
+        return E_NOT_SUFFICIENT_BUFFER;
+    }
+    memcpy( buffer, gdk_package_identifier, needed );
+    TRACE( "returning %s.\n", debugstr_a( buffer ) );
+    return S_OK;
 }
 
 static BOOLEAN WINAPI x_package_XPackageIsPackagedProcess( IXPackageImpl3 *iface )
 {
-    FIXME( "iface %p stub!\n", iface );
-    return FALSE;
+    /* The runtime only initializes with a MicrosoftGame.config, so a parsed identity means a packaged game. */
+    BOOLEAN packaged = *gdk_package_identifier != 0;
+
+    TRACE( "iface %p, returning %d.\n", iface, packaged );
+    return packaged;
 }
 
 static HRESULT WINAPI x_package_XPackageCreateInstallationMonitor( IXPackageImpl3 *iface, const char *packageIdentifier, UINT32 selectorCount, XPackageChunkSelector *selectors, UINT32 minimumUpdateIntervalMs, XTaskQueueHandle queue, XPackageInstallationMonitorHandle *installationMonitor )
@@ -119,8 +244,19 @@ static BOOLEAN WINAPI x_package_XPackageUnregisterInstallationProgressChanged( I
 
 static HRESULT WINAPI x_package_XPackageGetUserLocale( IXPackageImpl3 *iface, SIZE_T localeSize, char *locale )
 {
-    FIXME( "iface %p, localeSize %Iu, locale %p stub!\n", iface, localeSize, locale );
-    return E_NOTIMPL;
+    const char *value = getenv( "XODUS_LOCALE" );
+    SIZE_T needed;
+
+    TRACE( "iface %p, localeSize %Iu, locale %p.\n", iface, localeSize, locale );
+
+    if (!locale) return E_POINTER;
+    if (!value || !*value) value = "en-US";
+
+    needed = strlen( value ) + 1;
+    if (localeSize < needed) return E_NOT_SUFFICIENT_BUFFER;
+    memcpy( locale, value, needed );
+    TRACE( "returning %s.\n", debugstr_a( locale ) );
+    return S_OK;
 }
 
 static HRESULT WINAPI x_package_XPackageFindChunkAvailability( IXPackageImpl3 *iface, const char *packageIdentifier, UINT32 selectorCount, XPackageChunkSelector *selectors, XPackageChunkAvailability *availability )
@@ -197,19 +333,34 @@ static HRESULT WINAPI __PADDING_3__( IXPackageImpl3 *iface )
 
 static HRESULT WINAPI x_package_XPackageGetMountPathSize( IXPackageImpl3 *iface, XPackageMountHandle mount, SIZE_T *pathSize )
 {
-    FIXME( "iface %p, mount %p, pathSize %p stub!\n", iface, mount, pathSize );
-    return E_NOTIMPL;
+    TRACE( "iface %p, mount %p, pathSize %p.\n", iface, mount, pathSize );
+
+    if (!pathSize) return E_POINTER;
+    if (!mount) return E_GAMERUNTIME_INVALID_HANDLE;
+    *pathSize = strlen( mount->path ) + 1;
+    return S_OK;
 }
 
 static HRESULT WINAPI x_package_XPackageGetMountPath( IXPackageImpl3 *iface, XPackageMountHandle mount, SIZE_T pathSize, char *path )
 {
-    FIXME( "iface %p, mount %p, pathSize %Iu, path %p stub!\n", iface, mount, pathSize, path );
-    return E_NOTIMPL;
+    SIZE_T needed;
+
+    TRACE( "iface %p, mount %p, pathSize %Iu, path %p.\n", iface, mount, pathSize, path );
+
+    if (!path) return E_POINTER;
+    if (!mount) return E_GAMERUNTIME_INVALID_HANDLE;
+
+    needed = strlen( mount->path ) + 1;
+    if (pathSize < needed) return E_NOT_SUFFICIENT_BUFFER;
+    memcpy( path, mount->path, needed );
+    TRACE( "returning %s.\n", debugstr_a( path ) );
+    return S_OK;
 }
 
 static void WINAPI x_package_XPackageCloseMountHandle( IXPackageImpl3 *iface, XPackageMountHandle mount )
 {
-    FIXME( "iface %p, mount %p stub!\n", iface, mount );
+    TRACE( "iface %p, mount %p.\n", iface, mount );
+    close_mount( mount );
 }
 
 static HRESULT WINAPI __PADDING_4__( IXPackageImpl3 *iface )
@@ -218,10 +369,60 @@ static HRESULT WINAPI __PADDING_4__( IXPackageImpl3 *iface )
     return E_NOTIMPL;
 }
 
+/* Shared by the three XPackageEnumeratePackages vtable slots (IXPackageImpl, IXPackageImpl2, IXPackageImpl3). */
+static HRESULT enumerate_packages( XPackageKind kind, XPackageEnumerationScope scope, void *context, XPackageEnumerationCallback *callback )
+{
+    XPackageDetails details;
+    char title_id[9];
+
+    if (!callback) return E_POINTER;
+
+    switch (kind)
+    {
+    case XPackageKind_Game:
+        /* Only the running game is known, and every scope includes it. */
+        if (!*gdk_package_identifier)
+        {
+            WARN( "no package identifier, enumerating nothing.\n" );
+            return S_OK;
+        }
+        memset( &details, 0, sizeof(details) );
+        details.packageIdentifier = gdk_package_identifier;
+        details.version = parse_version( gdk_identity_version );
+        details.kind = XPackageKind_Game;
+        details.displayName = gdk_display_name;
+        details.description = "";
+        details.publisher = gdk_publisher_display_name;
+        details.storeId = gdk_store_id;
+        details.installing = FALSE;
+        details.index = 0;
+        details.count = 1;
+        details.ageRestricted = FALSE;
+        if (titleId) sprintf( title_id, "%08X", titleId ); /* 8 uppercase hex digits, as the GDK reports it */
+        else title_id[0] = 0;
+        details.titleID = title_id;
+
+        TRACE( "reporting %s version %u.%u.%u.%u, %s by %s, store id %s, title id %s.\n", debugstr_a( details.packageIdentifier ),
+               details.version.major, details.version.minor, details.version.build, details.version.revision,
+               debugstr_a( details.displayName ), debugstr_a( details.publisher ), debugstr_a( details.storeId ), debugstr_a( details.titleID ) );
+        callback( context, &details );
+        return S_OK;
+
+    case XPackageKind_Content:
+        /* No DLC is known to the runtime: nothing to enumerate. */
+        TRACE( "no content packages, scope %d.\n", scope );
+        return S_OK;
+
+    default:
+        FIXME( "unknown kind %d.\n", kind );
+        return E_INVALIDARG;
+    }
+}
+
 static HRESULT WINAPI x_package_XPackageEnumeratePackages( IXPackageImpl3 *iface, XPackageKind kind, XPackageEnumerationScope scope, void *context, XPackageEnumerationCallback *callback )
 {
-    FIXME( "iface %p, kind %d, scope %d, context %p, callback %p stub!\n", iface, kind, scope, context, callback );
-    return E_NOTIMPL;
+    TRACE( "iface %p, kind %d, scope %d, context %p, callback %p.\n", iface, kind, scope, context, callback );
+    return enumerate_packages( kind, scope, context, callback );
 }
 
