 }
 
 static HRESULT WINAPI x_package_XPackageRegisterPackageInstalled2( IXPackageImpl3 *iface, XTaskQueueHandle queue, void *context, XPackageInstalledCallback *callback, XTaskQueueRegistrationToken *token )
@@ -274,20 +475,59 @@ static HRESULT WINAPI x_package_XPackageRegisterPackageInstalled2( IXPackageImpl
 
 static HRESULT WINAPI x_package_XPackageMountWithUiAsync( IXPackageImpl3 *iface, const char *packageIdentifier, XAsyncBlock *async )
 {
-    FIXME( "iface %p, packageIdentifier %s, async %p stub!\n", iface, debugstr_a( packageIdentifier ), async );
-    return E_NOTIMPL;
+    struct mount_job *job;
+    IXThreadingImpl *xthreading;
+    HRESULT hr;
+
+    TRACE( "iface %p, packageIdentifier %s, async %p.\n", iface, debugstr_a( packageIdentifier ), async );
+
+    if (!packageIdentifier || !async) return E_POINTER;
+    if (!(job = calloc( 1, sizeof(*job) ))) return E_OUTOFMEMORY;
+
+    if (!*gdk_package_identifier || strcmp( packageIdentifier, gdk_package_identifier ))
+    {
+        /* Only the running game can be mounted; there is no package catalogue to look other identifiers up in. */
+        WARN( "unknown package %s, completing with E_GAMEPACKAGE_NO_PACKAGE_IDENTIFIER.\n", debugstr_a( packageIdentifier ) );
+        job->hr = E_GAMEPACKAGE_NO_PACKAGE_IDENTIFIER;
+    }
+    else if (!(job->mount = create_mount())) job->hr = E_OUTOFMEMORY;
+    else job->hr = S_OK;
+
+    if (FAILED( hr = QueryApiImpl( &CLSID_XThreadingImpl, &IID_IXThreadingImpl, (void **)&xthreading ) ))
+    {
+        close_mount( job->mount );
+        free( job );
+        return hr;
+    }
+    hr = IXThreadingImpl_XAsyncBegin( xthreading, async, job, mount_identity, "XPackageMountWithUiAsync", mount_job_provider );
+    IXThreadingImpl_Release( xthreading );
+    if (FAILED( hr )) /* only then has the provider never seen the job */
+    {
+        close_mount( job->mount );
+        free( job );
+    }
+    return hr;
 }
 
 static HRESULT WINAPI x_package_XPackageMountWithUiResult( IXPackageImpl3 *iface, XAsyncBlock *async, XPackageMountHandle *mount )
 {
-    FIXME( "iface %p, async %p, mount %p stub!\n", iface, async, mount );
-    return E_NOTIMPL;
+    IXThreadingImpl *xthreading;
+    HRESULT hr;
+
+    TRACE( "iface %p, async %p, mount %p.\n", iface, async, mount );
+
+    if (!async || !mount) return E_POINTER;
+    if (FAILED( hr = QueryApiImpl( &CLSID_XThreadingImpl, &IID_IXThreadingImpl, (void **)&xthreading ) )) return hr;
+    hr = IXThreadingImpl_XAsyncGetResult( xthreading, async, mount_identity, sizeof(*mount), mount, NULL );
+    IXThreadingImpl_Release( xthreading );
+    if (SUCCEEDED( hr )) TRACE( "mounted %s at %s.\n", debugstr_a( gdk_package_identifier ), debugstr_a( (*mount)->path ) );
+    return hr;
 }
 
