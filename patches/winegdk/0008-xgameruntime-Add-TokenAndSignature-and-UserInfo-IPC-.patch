+UserInfoResponse::UserInfoResponse(
+    const XodusUserIdentityData &identity,
+    HRESULT error,
+    HSTRING message )
+: Error(error)
+{
+    Identity.signedIn = identity.signedIn;
+    Identity.xuid = identity.xuid;
+    Identity.ageGroup = identity.ageGroup;
+    WindowsDuplicateString( identity.gamertag, &Identity.gamertag );
+    WindowsDuplicateString( identity.modernGamertag, &Identity.modernGamertag );
+    WindowsDuplicateString( identity.modernGamertagSuffix, &Identity.modernGamertagSuffix );
+    WindowsDuplicateString( identity.uniqueModernGamertag, &Identity.uniqueModernGamertag );
+    WindowsDuplicateString( identity.uhs, &Identity.uhs );
+    WindowsDuplicateString( message, &Message );
