+/* Content of an element -> HSTRING (replacing any previous value). */
+static HRESULT HStringFromNode( xmlNodePtr node, HSTRING *out )
+{
+    xmlChar *content = xmlNodeGetContent( node );
+    HRESULT hr;
+
+    WindowsDeleteString( *out );
+    hr = HStringFromUtf8( XmlStr( content ), out );
+    xmlFree( content );
+    return hr;
+}
