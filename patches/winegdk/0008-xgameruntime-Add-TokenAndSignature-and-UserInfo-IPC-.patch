+/*
+ * Socket connect + reader thread + PING round trip. Every failure is reported with TRACE only and
+ * leaves the runtime in offline mode; nothing here may surface to the game.
+ */
+static HRESULT
+ConnectXodusService()
 {
-    DWORD async;
+    const char *offline = getenv( "XODUS_OFFLINE" );
+    NTSTATUS nts;
     HRESULT hr;
+    DWORD wait;
 
     IAsyncAction *pingAction = nullptr;
 
+    if ( offline && *offline && strcmp( offline, "0" ) )
+    {
+        TRACE( "XODUS_OFFLINE is set, not connecting to the xodus service.\n" );
+        return HRESULT_FROM_WIN32( ERROR_NOT_CONNECTED );
+    }
+
+    if ( !unixlib )
+    {
+        TRACE( "unix lib not loaded, staying offline.\n" );
+        return HRESULT_FROM_WIN32( ERROR_MOD_NOT_FOUND );
+    }
+
+    nts = __wine_unix_call( unixhandle, conn_socket, (void *)XODUS_SOCKET_SUFFIX );
+    if ( nts != STATUS_SUCCESS )
+    {
+        TRACE( "could not connect to the xodus service socket (status %#lx), staying offline.\n", nts );
+        return HRESULT_FROM_WIN32( ERROR_NOT_CONNECTED );
+    }
+
     hr = xodus_ipclayer->InitializeSocket();
-    if ( FAILED( hr ) ) 
+    if ( FAILED( hr ) )
     {
-        WARN("Socket initialization failed with %#lx\n", hr);
+        TRACE( "socket reader could not be started (%#lx), staying offline.\n", hr );
         return hr;
     }
+
     hr = xodus_service->Ping( &pingAction );
-    if ( FAILED( hr ) ) 
+    if ( FAILED( hr ) )
     {
-        WARN("Xodus Ping Dispatch failed with %#lx\n", hr);
+        TRACE( "PING could not be dispatched (%#lx), staying offline.\n", hr );
         return hr;
     }
 
-    async = AsyncActionCompletedHandler::await_AsyncAction( pingAction, 10000 );
-    if ( async )
+    wait = AsyncActionCompletedHandler::await_AsyncAction( pingAction, IPC_PING_TIMEOUT_MS + 1000 );
+    if ( wait == WAIT_OBJECT_0 )
+        hr = pingAction->GetResults();
+    else
+        hr = HRESULT_FROM_WIN32( ERROR_TIMEOUT );
+    pingAction->Release();
+
+    if ( FAILED( hr ) )
     {
-        if ( async == STATUS_TIMEOUT )
-        {
-            WARN("Timeout while waiting for PING response.\n");
-            return HRESULT_FROM_WIN32( ERROR_TIMEOUT );
-        }
-            
-        WARN("Async action await failed. Status was %ld\n", async);
-        return E_FAIL;
+        TRACE( "the xodus service did not answer the PING (%#lx), staying offline.\n", hr );
+        return hr;
     }
 
-    hr = pingAction->GetResults();
+    TRACE( "connected to the xodus service.\n" );
+    return S_OK;
+}
+
+HRESULT WINAPI
+XodusEnsureService()
+{
+    const std::lock_guard<std::mutex> lock( g_service_lock );
+
+    if ( !g_service_attempted )
+    {
+        g_service_attempted = true;
+        g_service_status = ConnectXodusService();
+    }
+
+    return g_service_status;
+}
+
+#if XODUS_INTEROP
+static HRESULT WINAPI
+InitializeXodusService()
+{
+    HRESULT hr = XodusEnsureService();
+
