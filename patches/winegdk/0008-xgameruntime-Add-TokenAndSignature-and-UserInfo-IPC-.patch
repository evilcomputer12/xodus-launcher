+    if ( node->type != XML_ELEMENT_NODE ) return false;
+
+    if ( IsElement( node, "Xuid" ) )
+    {
+        content = xmlNodeGetContent( node );
+        identity.xuid = content ? strtoull( XmlStr( content ), nullptr, 10 ) : 0;
+        xmlFree( content );
+    }
+    else if ( IsElement( node, "Gamertag" ) ) *hr = HStringFromNode( node, &identity.gamertag );
+    else if ( IsElement( node, "ModernGamertag" ) ) *hr = HStringFromNode( node, &identity.modernGamertag );
+    else if ( IsElement( node, "ModernGamertagSuffix" ) ) *hr = HStringFromNode( node, &identity.modernGamertagSuffix );
+    else if ( IsElement( node, "UniqueModernGamertag" ) ) *hr = HStringFromNode( node, &identity.uniqueModernGamertag );
+    else if ( IsElement( node, "Uhs" ) ) *hr = HStringFromNode( node, &identity.uhs );
+    else if ( IsElement( node, "AgeGroup" ) )
+    {
+        content = xmlNodeGetContent( node );
+        identity.ageGroup = ParseAgeGroup( XmlStr( content ) );
