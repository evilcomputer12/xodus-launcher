+static inline xmlNodePtr AddTextChild( xmlNodePtr parent, LPCSTR name, LPCSTR value )
+{
+    return xmlNewTextChild( parent, nullptr, BAD_CAST name, BAD_CAST (value ? value : "") );
+}
+
+static HRESULT ParseResponseDocument( LPCSTR xml_string, LPCSTR rootName, xmlDocPtr *doc, xmlNodePtr *root )
+{
+    *doc = nullptr;
+    *root = nullptr;
+
+    /* An empty body is what the service sends when it could not parse the request. */
+    if ( !xml_string || !*xml_string ) return E_FAIL;
+
+    if ( !( *doc = xmlReadMemory( xml_string, strlen( xml_string ), nullptr, nullptr, RESPONSE_PARSE_OPTIONS ) ) ) return E_FAIL;
+    if ( !( *root = xmlDocGetRootElement( *doc ) ) || strcmp( XmlStr( (*root)->name ), rootName ) )
+    {
+        WARN( "unexpected response root element (wanted %s)\n", rootName );
+        xmlFreeDoc( *doc );
+        *doc = nullptr;
+        *root = nullptr;
+        return E_FAIL;
+    }
+    return S_OK;
+}
