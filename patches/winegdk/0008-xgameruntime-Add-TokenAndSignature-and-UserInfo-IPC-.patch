+HRESULT WINAPI
+UserInfoResponse::QueryInterface( REFIID iid, void **out ) noexcept
+{
+    TRACE( "iface %p, iid %s, out %p.\n", this, debugstr_guid( &iid ), out );
+
+    if (!out) return E_POINTER;
+    *out = nullptr;
+
+    if ( iid == __uuidof( IUnknown ) ||
+         iid == __uuidof( IInspectable ) ||
+         iid == __uuidof( IAgileObject ) ||
+         iid == __uuidof( IUserInfoResponse ) )
+    {
+        AddRef();
+        *out = static_cast<IUserInfoResponse *>(this);
+        return S_OK;
+    }
