+/* Base64 (no line breaks) of a byte range, CoTaskMemAlloc'ed. */
+static HRESULT Base64Encode( const BYTE *data, UINT32 size, LPSTR *out )
+{
+    DWORD len = 0;
+
+    *out = nullptr;
+    if ( !CryptBinaryToStringA( data, size, CRYPT_STRING_BASE64 | CRYPT_STRING_NOCRLF, nullptr, &len ) )
+        return HRESULT_FROM_WIN32( GetLastError() );
+    *out = (LPSTR)CoTaskMemAlloc( len + 1 );
+    if ( !*out ) return E_OUTOFMEMORY;
+    if ( !CryptBinaryToStringA( data, size, CRYPT_STRING_BASE64 | CRYPT_STRING_NOCRLF, *out, &len ) )
+    {
+        CoTaskMemFree( *out );
+        *out = nullptr;
+        return HRESULT_FROM_WIN32( GetLastError() );
+    }
+    (*out)[len] = 0;
+    return S_OK;
+}
