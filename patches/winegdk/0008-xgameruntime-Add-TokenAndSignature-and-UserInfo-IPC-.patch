+/* UTF-8 (NUL terminated, may be NULL) -> HSTRING. */
+static HRESULT HStringFromUtf8( LPCSTR str, HSTRING *out )
+{
+    INT strLen;
+    LPWSTR strW;
+    HRESULT hr;
+
+    *out = nullptr;
+    if ( !str || !*str ) return S_OK; /* NULL HSTRING is the empty string */
+
+    strLen = MultiByteToWideChar( CP_UTF8, 0, str, -1, nullptr, 0 );
+    if ( !strLen ) return HRESULT_FROM_WIN32( GetLastError() );
+    strW = (LPWSTR)CoTaskMemAlloc( strLen * sizeof(WCHAR) );
+    if ( !strW ) return E_OUTOFMEMORY;
+    MultiByteToWideChar( CP_UTF8, 0, str, -1, strW, strLen );
+    hr = WindowsCreateString( strW, strLen - 1, out );
+    CoTaskMemFree( strW );
+    return hr;
+}
