@@ -42,6 +43,18 @@ LPCSTR msaAppId;
 UINT32 titleId;
 BOOLEAN fullTrust;
 
+/* MicrosoftGame.config values (see private.h); "" until ObtainMsaAppId() has parsed them. */
+static const WCHAR empty_w[] = { 0 };
+const char *gdk_identity_name = "";
+const char *gdk_identity_publisher = "";
+const char *gdk_identity_version = "";
+const char *gdk_display_name = "";
+const char *gdk_publisher_display_name = "";
+const char *gdk_store_id = "";
+const char *gdk_package_identifier = "";
