+/* The store back end (catalog, purchases, package updates, license tokens) is not implemented.
+ * Those requests still complete asynchronously, with E_GAMESTORE_NETWORK_ERROR, so a game that
+ * waits on the XAsyncBlock sees a normal failed call instead of hanging on a never-completing one. */
+static HRESULT x_store_unavailable_work( struct x_store_job *job )
+{
+    job->result_size = 0;
+    return E_GAMESTORE_NETWORK_ERROR;
+}
+
+static HRESULT x_store_begin_unavailable( const void *handle, XAsyncBlock *async, const void *identity, const char *name )
+{
+    struct x_store_job *job;
+
+    if (!handle) return E_GAMERUNTIME_INVALID_HANDLE;
+    if (!async) return E_POINTER;
+    if (!(job = calloc( 1, sizeof(*job) ))) return E_OUTOFMEMORY;
+    job->work = x_store_unavailable_work;
+    return x_store_begin_job( async, identity, name, job );
+}
+
+static HRESULT x_store_get_job_result_size( XAsyncBlock *async, SIZE_T *size )
+{
+    IXThreadingImpl *xthreading;
+    HRESULT hr;
+
+    if (!async || !size) return E_POINTER;
+    if (FAILED( hr = QueryApiImpl( &CLSID_XThreadingImpl, &IID_IXThreadingImpl, (void **)&xthreading ) )) return hr;
+    hr = IXThreadingImpl_XAsyncGetResultSize( xthreading, async, size );
+    IXThreadingImpl_Release( xthreading );
+    return hr;
+}
+
+/* An installed Game Pass base game has no add-on licenses and no entitled products to report:
+ * those two queries succeed with an empty answer. The count payload exists only so that the
+ * Result call can retrieve (and release) the completed operation like any other. */
+static HRESULT x_store_empty_count_work( struct x_store_job *job )
+{
+    job->result.count = 0;
+    job->result_size = sizeof(job->result.count);
+    return S_OK;
+}
+
+static void x_store_empty_count_fill( struct x_store_job *job, void *buffer )
+{
+    memcpy( buffer, &job->result.count, sizeof(job->result.count) );
+}
+
+#define X_STORE_PRODUCT_QUERY_MAGIC 0x51505358 /* 'XSPQ' */
+struct x_store_product_query
+{
+    UINT32 magic;
+};
+
+static HRESULT x_store_empty_query_work( struct x_store_job *job )
+{
+    struct x_store_product_query *query;
+
+    if (!(query = calloc( 1, sizeof(*query) ))) return E_OUTOFMEMORY;
+    query->magic = X_STORE_PRODUCT_QUERY_MAGIC;
+    job->result.query = query;
+    job->result_size = sizeof(job->result.query);
+    return S_OK;
+}
+
+static void x_store_empty_query_fill( struct x_store_job *job, void *buffer )
+{
+    memcpy( buffer, &job->result.query, sizeof(job->result.query) );
+}
