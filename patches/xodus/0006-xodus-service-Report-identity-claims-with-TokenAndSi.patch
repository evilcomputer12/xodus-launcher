+fn user_only_identity(xsts: &XstsResponse) -> Result<UserIdentity, TokenError> {
+    xsts.xui()
+        .map(UserIdentity::from)
+        .ok_or_else(|| TokenError::new(E_FAIL, "XSTS token without user hash"))
+}
